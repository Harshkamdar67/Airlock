#!/usr/bin/env bash
# Managed by https://github.com/Harshkamdar67/Airlock
set -euo pipefail

resolve_airlock_config_root() {
  local standard_root fallback_root standard_parent
  if [[ -n "${AIRLOCK_CONFIG_DIR:-}" ]]; then
    printf '%s' "$AIRLOCK_CONFIG_DIR"
    return 0
  fi
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    printf '%s' "$XDG_CONFIG_HOME/airlock"
    return 0
  fi
  standard_root="$HOME/.config/airlock"
  fallback_root="$HOME/.airlock"
  standard_parent="$HOME/.config"
  if [[ -f "$fallback_root/config" || -d "$fallback_root" ]]; then
    printf '%s' "$fallback_root"
  elif [[ -d "$standard_root" && -w "$standard_root" ]]; then
    printf '%s' "$standard_root"
  elif [[ ! -e "$standard_root" && -d "$standard_parent" && -w "$standard_parent" ]]; then
    printf '%s' "$standard_root"
  elif [[ ! -e "$standard_parent" && -w "$HOME" ]]; then
    printf '%s' "$standard_root"
  else
    printf '%s' "$fallback_root"
  fi
}

directory_is_writable_or_creatable() {
  local directory="$1"
  local parent
  if [[ -d "$directory" ]]; then
    [[ -w "$directory" ]]
    return
  fi
  [[ ! -e "$directory" ]] || return 1
  parent="$(dirname "$directory")"
  while [[ ! -e "$parent" ]]; do
    directory="$parent"
    parent="$(dirname "$directory")"
    [[ "$parent" != "$directory" ]] || break
  done
  [[ -d "$parent" && -w "$parent" ]]
}

config_root="$(resolve_airlock_config_root)"
case "$config_root" in
  /*|[A-Za-z]:[\\/]*) ;;
  *) config_root="$(pwd)/$config_root" ;;
esac
config_file="${AIRLOCK_CONFIG_FILE:-$config_root/config}"
openai_direct_agents_file="${AIRLOCK_OPENAI_DIRECT_AGENTS_FILE:-$config_root/openai-direct-agents.json}"
anthropic_direct_agents_file="${AIRLOCK_ANTHROPIC_DIRECT_AGENTS_FILE:-$config_root/anthropic-direct-agents.json}"
openai_wrapper_agents_file="${AIRLOCK_HYBRID_AGENTS_FILE:-$config_root/hybrid-agents.json}"
anthropic_wrapper_agents_file="${AIRLOCK_CLAUDE_AGENTS_FILE:-$config_root/claude-agents.json}"
grok_direct_agents_file="${AIRLOCK_GROK_DIRECT_AGENTS_FILE:-$config_root/grok-agents.json}"
grok_wrapper_agents_file="${AIRLOCK_GROK_WRAPPER_AGENTS_FILE:-${AIRLOCK_GROK_AGENTS_FILE:-$config_root/grok-agents.json}}"
access_helper="${AIRLOCK_ACCESS_HELPER:-$(dirname "$0")/airlock-access.py}"
policy_helper="${AIRLOCK_POLICY_HELPER_PATH:-$(dirname "$access_helper")/airlock_policy.py}"
openrouter_auth_helper="${AIRLOCK_OPENROUTER_AUTH_HELPER:-$(dirname "$access_helper")/airlock_openrouter_auth.py}"
openrouter_presets_helper="${AIRLOCK_OPENROUTER_PRESETS_HELPER:-$(dirname "$access_helper")/airlock_openrouter_presets.py}"
openrouter_models_helper="${AIRLOCK_OPENROUTER_MODELS_HELPER:-$(dirname "$access_helper")/airlock_openrouter_models.py}"
openrouter_registry_file="${AIRLOCK_OPENROUTER_REGISTRY_FILE:-$config_root/openrouter-registry.json}"
router_helper="${AIRLOCK_ROUTER_HELPER:-$(dirname "$access_helper")/airlock-router.py}"
update_helper="${AIRLOCK_UPDATE_HELPER:-$(dirname "$access_helper")/airlock-update.py}"
managed_bin_dir="${AIRLOCK_MANAGED_BIN_DIR:-$(dirname "$access_helper")}"
bundle_file="${AIRLOCK_MANAGED_BUNDLE_FILE:-$config_root/managed-bundle.json}"
plugin_dir="${AIRLOCK_PLUGIN_DIR:-$config_root/plugins/airlock}"
update_notice_file="$config_root/update-notice.json"
python_bin="${AIRLOCK_PYTHON:-}"
python_is_usable() {
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info.major == 3 else 1)' >/dev/null 2>&1
}
if [[ -n "$python_bin" ]]; then
  if ! python_is_usable "$python_bin"; then
    printf 'airlock: AIRLOCK_PYTHON is not a usable Python 3 interpreter: %s\n' "$python_bin" >&2
    exit 1
  fi
else
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && python_is_usable "$candidate"; then
      python_bin="$(command -v "$candidate")"
      break
    fi
  done
fi
if [[ -n "$python_bin" ]]; then
  export AIRLOCK_PYTHON="$python_bin"
fi
config_model=''
config_default_profile=''
config_hybrid_model=''
config_main_effort=''
config_bg_model=''
config_bg_effort=''
config_small_fast_model=''
config_context_window=''
config_proxy_url=''
config_proxy_config_dir=''
config_proxy_state_home=''
config_max_agents=''
config_agent_depth=''
config_openai_fast=''
config_anthropic_fast=''
config_extra_usage=''
config_gpt_effort_capabilities=''
config_grok_model=''

if [[ -f "$config_file" ]]; then
  while IFS='=' read -r config_key config_value; do
    config_value="${config_value%$'\r'}"
    case "$config_key" in
      AIRLOCK_MODEL) config_model="$config_value" ;;
      AIRLOCK_DEFAULT_PROFILE) config_default_profile="$config_value" ;;
      AIRLOCK_HYBRID_MODEL) config_hybrid_model="$config_value" ;;
      AIRLOCK_GROK_MODEL) config_grok_model="$config_value" ;;
      AIRLOCK_MAIN_EFFORT) config_main_effort="$config_value" ;;
      AIRLOCK_BG_MODEL) config_bg_model="$config_value" ;;
      AIRLOCK_BG_EFFORT) config_bg_effort="$config_value" ;;
      AIRLOCK_SMALL_FAST_MODEL) config_small_fast_model="$config_value" ;;
      AIRLOCK_CONTEXT_WINDOW) config_context_window="$config_value" ;;
      AIRLOCK_PROXY_URL) config_proxy_url="$config_value" ;;
      AIRLOCK_PROXY_CONFIG_DIR) config_proxy_config_dir="$config_value" ;;
      AIRLOCK_PROXY_STATE_HOME) config_proxy_state_home="$config_value" ;;
      AIRLOCK_MAX_CONCURRENT_SUBAGENTS) config_max_agents="$config_value" ;;
      AIRLOCK_AGENT_DEPTH) config_agent_depth="$config_value" ;;
      AIRLOCK_OPENAI_FAST) config_openai_fast="$config_value" ;;
      AIRLOCK_ANTHROPIC_FAST) config_anthropic_fast="$config_value" ;;
      AIRLOCK_EXTRA_USAGE_POLICY) config_extra_usage="$config_value" ;;
      AIRLOCK_GPT_EFFORT_CAPABILITIES) config_gpt_effort_capabilities="$config_value" ;;
      AIRLOCK_AUTO_MODE_MODEL) config_auto_mode_model="$config_value" ;;
    esac
  done < "$config_file"
fi

normalize_openai_model_id() {
  local model="$1"
  if [[ "$model" == gpt-* && "$model" == *'[1m]' ]]; then
    model="${model%\[1m\]}"
  fi
  printf '%s' "$model"
}

config_model="$(normalize_openai_model_id "$config_model")"
config_hybrid_model="$(normalize_openai_model_id "$config_hybrid_model")"
config_bg_model="$(normalize_openai_model_id "$config_bg_model")"
config_small_fast_model="$(normalize_openai_model_id "$config_small_fast_model")"

proxy_url="${AIRLOCK_PROXY_URL:-${config_proxy_url:-http://127.0.0.1:18765}}"
proxy_config_dir="${CCP_CONFIG_DIR:-${AIRLOCK_PROXY_CONFIG_DIR:-$config_proxy_config_dir}}"
proxy_state_home="${XDG_STATE_HOME:-${AIRLOCK_PROXY_STATE_HOME:-$config_proxy_state_home}}"
case "$(uname -s)" in
  Darwin) default_proxy_config_dir="$HOME/.config/claude-code-proxy" ;;
  *) default_proxy_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code-proxy" ;;
esac
default_proxy_state_home="$HOME/.local/state"
if [[ -z "$proxy_config_dir" ]] && ! directory_is_writable_or_creatable "$default_proxy_config_dir"; then
  proxy_config_dir="$config_root/claude-code-proxy"
fi
if [[ -z "$proxy_state_home" ]] && ! directory_is_writable_or_creatable "$default_proxy_state_home"; then
  proxy_state_home="$config_root/proxy-state"
fi
background_model="${AIRLOCK_SMALL_FAST_MODEL:-${AIRLOCK_BACKGROUND_MODEL:-${config_small_fast_model:-gpt-5.6-sol}}}"
background_model="$(normalize_openai_model_id "$background_model")"
# Legacy GPT [1m] values remain accepted at launcher boundaries, but all
# resolved OpenAI IDs are bare before they reach the session policy.
explicit_context_window=0
if [[ -n "${AIRLOCK_CONTEXT_WINDOW+x}" ]]; then
  explicit_context_window=1
fi
default_context_window="${AIRLOCK_CONTEXT_WINDOW-${config_context_window:-272000}}"
# A window the user set themselves outranks Airlock's default. Record it before
# any proxy cleanup unsets it.
user_context_window="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-}"
# Claude Code accepts 100000 to 1000000 and silently ignores everything else, so
# an unchecked value here would look applied while doing nothing at all.
if [[ "$default_context_window" != 'auto' ]]; then
  if [[ ! "$default_context_window" =~ ^[1-9][0-9]{5,6}$ ]] \
    || (( default_context_window < 100000 || default_context_window > 1000000 )); then
    printf "airlock: AIRLOCK_CONTEXT_WINDOW must be 'auto' or a whole number from 100000 to 1000000.\n" >&2
    exit 2
  fi
fi
gpt_effort_capabilities="${AIRLOCK_GPT_EFFORT_CAPABILITIES:-${config_gpt_effort_capabilities:-effort,xhigh_effort,max_effort}}"
# The hybrid launcher rebuilds these declarations itself, so hand it the
# resolved value rather than letting it fall back to the built-in default.
export AIRLOCK_GPT_EFFORT_CAPABILITIES="$gpt_effort_capabilities"
auto_mode_model="${AIRLOCK_AUTO_MODE_MODEL:-${config_auto_mode_model:-}}"
export AIRLOCK_AUTO_MODE_MODEL="$auto_mode_model"
default_profile="${AIRLOCK_DEFAULT_PROFILE:-${config_default_profile:-openai}}"
default_hybrid_model="${AIRLOCK_HYBRID_MODEL:-${config_hybrid_model:-sonnet}}"
default_openai_model="${AIRLOCK_MODEL:-${config_model:-sol}}"
default_grok_model="${AIRLOCK_GROK_MODEL:-${config_grok_model:-grok}}"
default_bg_model="${AIRLOCK_BG_MODEL:-${config_bg_model:-sol}}"
default_hybrid_model="$(normalize_openai_model_id "$default_hybrid_model")"
default_openai_model="$(normalize_openai_model_id "$default_openai_model")"
default_bg_model="$(normalize_openai_model_id "$default_bg_model")"
openai_fast_policy="${AIRLOCK_OPENAI_FAST:-${config_openai_fast:-off}}"
anthropic_fast_policy="${AIRLOCK_ANTHROPIC_FAST:-${config_anthropic_fast:-off}}"
extra_usage_policy="${AIRLOCK_EXTRA_USAGE_POLICY:-${config_extra_usage:-ask}}"
airlock_fast_handoff_hop=0

print_models() {
  cat <<'EOF'
Usage: airlock [claude arguments]
       airlock openai [model] [claude arguments]
       airlock grok [model] [claude arguments]
       airlock hybrid [model|choose] [claude arguments]
       airlock opr [route] [claude arguments]
       airlock [sol|terra|luna|...] [claude arguments]

Profiles:
  airlock          Start the saved default profile and orchestrator
  airlock openai   Start the saved OpenAI-only orchestrator
  airlock grok     Start the saved Grok-only orchestrator (subscription proxy)
  airlock hybrid   Start the saved hybrid orchestrator
  airlock fast     Start one session with OpenAI Fast without saving the mode
  airlock opr      Start an OpenRouter-only session on an exact registry route
  claude           Start the native Anthropic CLI without Airlock

OpenAI root aliases: sol, sol-fast, terra, luna, 5.5, 5.4, mini, 5.3, spark, 5.2
Grok root aliases: grok, composer
Hybrid root aliases: auto, sonnet, sol, terra, luna, opus, fable, haiku, grok, composer
  auto resolves to fable when Fable is neither extra nor unavailable, otherwise
  opus under the same rule, otherwise sonnet.
OpenRouter roots: exact enabled route slugs from airlock openrouter models list
Other commands: fast, bg, mode, usage, session-usage, access, bundle, config, models, openrouter auth/models, proxy auth, version, update

OpenRouter credential commands:
  airlock openrouter auth set-key     Store a key using a hidden prompt
  airlock openrouter auth set-key --stdin
  airlock openrouter auth status      Show only local credential state
  airlock openrouter auth logout      Delete the local credential after confirmation

OpenRouter model registry commands:
  airlock openrouter models list
  airlock openrouter models presets
  airlock openrouter models add-preset NAME [--yes]
  airlock openrouter models add ROUTE MODEL ENDPOINT [--yes]
  airlock openrouter models remove ROUTE [--yes]
  airlock openrouter models refresh [ROUTE] [--apply] [--yes]

Proxy login commands:
  airlock proxy auth status          Check Codex OAuth in Airlock's selected proxy directory
  airlock proxy auth login           Start the upstream browser login
  airlock proxy auth device          Start the upstream device-code login
  airlock proxy grok auth status     Check Grok OAuth in Airlock's selected proxy directory
  airlock proxy grok auth login      Start the upstream Grok browser login
  airlock proxy grok auth device     Start the upstream Grok device-code login

Policy commands:
  airlock mode                     Show the saved routing and usage policy
  airlock mode balanced|economy|quality
  airlock mode budget              Prefer economy routes and block extra usage
  airlock mode defaults            Restore tested policy defaults
  airlock mode extra-usage ask|never|allow
  airlock mode failover ask|never|allow
  airlock mode max-agents off|1..20
  airlock mode fast all|openai|anthropic|off
  airlock mode openai-fast on|off
  airlock mode anthropic-fast on|off
  airlock mode swarm-fast auto|on|off
  airlock mode set --routing economy --extra-usage never --failover ask --max-agents off --openai-fast off --anthropic-fast off --swarm-fast auto
  airlock usage                    Show cached sanitized subscription usage
  airlock usage refresh            Refresh OpenAI quota windows without a model call
  airlock usage set --claude-plan pro|max5x|max20x|unknown
  airlock usage set --openai-capacity auto|1x|5x|20x
  airlock usage defaults           Clear capacity overrides
  airlock session-usage [--json]   Show router-observed token counts for this hybrid session

Update commands:
  airlock version                  Show the installed Airlock version
  airlock update                   Download, verify, and confirm an update
  airlock update --check           Check without downloading or installing
  airlock update --yes             Install without an interactive confirmation

Examples:
  airlock                          # saved default profile and orchestrator
  airlock openai                   # saved OpenAI-only orchestrator
  airlock grok                     # saved Grok-only orchestrator
  airlock terra                    # explicit OpenAI-only root
  airlock hybrid                   # saved hybrid orchestrator
  airlock hybrid choose            # interactive hybrid root picker
  airlock hybrid opus              # explicit hybrid root
  airlock hybrid grok              # hybrid with Grok orchestrator
  airlock opr kimi-k3 -r           # resume with an exact OpenRouter root
  airlock opr                       # interactive OpenRouter route picker
  airlock access refresh

Inside a session:
  /effort changes the root and workers that are configured to follow it.
  Named airlock-* workers use fixed exact models and cannot start more workers.
  /model accepts only exact model IDs enabled for the active profile. Some GPT IDs may not appear in its menu.
  Exit and relaunch with another explicit root when switching through /model is unavailable.
  The orchestrator may choose only from the user-enabled worker pool.
  /airlock:usage refreshes sanitized usage with one small root-model turn.
  Top-level workers use Claude Code's native concurrency unless an Airlock ceiling is saved.
EOF
}

run_access() {
  if [[ ! -f "$access_helper" || -L "$access_helper" ]]; then
    printf 'airlock: managed access helper is missing or unsafe: %s\n' "$access_helper" >&2
    return 1
  fi
  if [[ -z "$python_bin" ]]; then
    printf 'airlock: Python 3 is required for access-policy handling.\n' >&2
    return 1
  fi
  "$python_bin" "$access_helper" "$@"
}

run_update() {
  if [[ ! -f "$update_helper" || -L "$update_helper" ]]; then
    printf 'airlock: managed update helper is missing or unsafe: %s\n' "$update_helper" >&2
    return 1
  fi
  if [[ -z "$python_bin" ]]; then
    printf 'airlock: Python 3 is required for release updates.\n' >&2
    return 1
  fi
  "$python_bin" "$update_helper" "$@"
}

run_openrouter_auth() {
  if [[ ! -f "$openrouter_auth_helper" || -L "$openrouter_auth_helper" ]]; then
    printf 'airlock: managed OpenRouter credential helper is missing or unsafe: %s\n' \
      "$openrouter_auth_helper" >&2
    return 1
  fi
  if [[ -z "$python_bin" ]]; then
    printf 'airlock: Python 3 is required for OpenRouter credential storage.\n' >&2
    return 1
  fi
  "$python_bin" "$openrouter_auth_helper" "$@"
}

run_openrouter_models() {
  if [[ ! -f "$openrouter_models_helper" || -L "$openrouter_models_helper" ]]; then
    printf 'airlock: managed OpenRouter model helper is missing or unsafe: %s\n' \
      "$openrouter_models_helper" >&2
    return 1
  fi
  if [[ -z "$python_bin" ]]; then
    printf 'airlock: Python 3 is required for OpenRouter model registry management.\n' >&2
    return 1
  fi
  "$python_bin" "$openrouter_models_helper" \
    --registry "$openrouter_registry_file" "$@"
}

validate_managed_bundle() {
  if [[ -z "$python_bin" ]]; then
    printf 'airlock: Python 3 is required to validate the managed installation.\n' >&2
    return 1
  fi
  local -a bundle_args=(
    bundle-check --quiet --platform posix --bundle "$bundle_file"
    --component "bin/airlock=$0"
    --component "bin/airlock-access.py=$access_helper"
    --component "bin/airlock_policy.py=$policy_helper"
    --component "bin/airlock_openrouter_auth.py=$openrouter_auth_helper"
    --component "bin/airlock_openrouter_presets.py=$openrouter_presets_helper"
    --component "bin/airlock_openrouter_models.py=$openrouter_models_helper"
    --component "bin/airlock-update.py=$update_helper"
    --component "bin/airlock-router.py=$router_helper"
    --component "bin/airlock-hybrid.py=$managed_bin_dir/airlock-hybrid.py"
    --component "config/openai-direct-agents.json=$openai_direct_agents_file"
    --component "config/anthropic-direct-agents.json=$anthropic_direct_agents_file"
    --component "config/hybrid-agents.json=$openai_wrapper_agents_file"
    --component "config/claude-agents.json=$anthropic_wrapper_agents_file"
    --component "config/grok-agents.json=$grok_direct_agents_file"
    --component "plugins/airlock/.claude-plugin/plugin.json=$plugin_dir/.claude-plugin/plugin.json"
    --component "plugins/airlock/hooks/hooks.json=$plugin_dir/hooks/hooks.json"
    --component "plugins/airlock/skills/usage/SKILL.md=$plugin_dir/skills/usage/SKILL.md"
    --component "plugins/airlock/skills/airlock-fast/SKILL.md=$plugin_dir/skills/airlock-fast/SKILL.md"
    --component "plugins/airlock/mcp-server/airlock_web_tools.py=$plugin_dir/mcp-server/airlock_web_tools.py"
    --component "plugins/airlock/scripts/fast-session-end.sh=$plugin_dir/scripts/fast-session-end.sh"
    --component "plugins/airlock/scripts/fast-session-end.py=$plugin_dir/scripts/fast-session-end.py"
    --component "plugins/airlock/scripts/agent-guard.sh=$plugin_dir/scripts/agent-guard.sh"
    --component "plugins/airlock/scripts/agent-guard.py=$plugin_dir/scripts/agent-guard.py"
    --component "plugins/airlock/scripts/secret-guard.sh=$plugin_dir/scripts/secret-guard.sh"
    --component "plugins/airlock/scripts/secret-guard.py=$plugin_dir/scripts/secret-guard.py"
    --component "plugins/airlock/scripts/update-notice.sh=$plugin_dir/scripts/update-notice.sh"
    --component "plugins/airlock/scripts/update-notice.py=$plugin_dir/scripts/update-notice.py"
    --component "plugins/airlock/scripts/file_safety.py=$plugin_dir/scripts/file_safety.py"
    --component "plugins/airlock/scripts/worktree.py=$plugin_dir/scripts/worktree.py"
    --component "plugins/airlock/scripts/worktree-create.sh=$plugin_dir/scripts/worktree-create.sh"
    --component "plugins/airlock/scripts/worktree-remove.sh=$plugin_dir/scripts/worktree-remove.sh"
  )
  if ! "$python_bin" "$access_helper" "${bundle_args[@]}"; then
    printf 'airlock: managed files are stale or incomplete. Reinstall Airlock, then start a fresh session.\n' >&2
    return 1
  fi
}

print_config() {
  local configured_openai configured_hybrid openai_display hybrid_display proxy_storage_display context_window_display
  validate_default_profile "$default_profile" || return 1
  configured_openai="$default_openai_model"
  configured_hybrid="$default_hybrid_model"
  openai_display="$(openai_model_display "$configured_openai")" || return 1
  hybrid_display="$(hybrid_model_display "$configured_hybrid")" || return 1
  proxy_storage_display='upstream defaults'
  [[ -z "$proxy_config_dir" && -z "$proxy_state_home" ]] || proxy_storage_display='configured proxy directories'
  if [[ "$default_context_window" == 'auto' ]]; then
    context_window_display='auto (Claude Code decides)'
  elif (( explicit_context_window )); then
    context_window_display="$default_context_window (explicit process-wide override)"
  else
    context_window_display="$default_context_window (saved fallback for OpenAI and Grok roots)"
  fi
  cat <<EOF
Config file: $config_file
Default profile: $default_profile
Default command: airlock -> $([[ "$default_profile" == 'hybrid' ]] && printf '%s' "$hybrid_display" || printf '%s' "$openai_display")
Hybrid root: $hybrid_display
OpenAI root: $openai_display
Main effort: ${AIRLOCK_MAIN_EFFORT:-${config_main_effort:-high}}
Background command: airlock bg -> $(openai_model_display "$default_bg_model") / ${AIRLOCK_BG_EFFORT:-${AIRLOCK_BACKGROUND_EFFORT:-${config_bg_effort:-medium}}} effort
Utility model: $background_model
Context window: $context_window_display
Proxy URL: $proxy_url
Proxy storage: $proxy_storage_display
OpenAI direct agents: $openai_direct_agents_file
Anthropic direct agents: $anthropic_direct_agents_file
OpenAI bridge agents: $openai_wrapper_agents_file
Anthropic bridge agents: $anthropic_wrapper_agents_file
Managed plugin: $plugin_dir
Max concurrent top-level subagents: ${AIRLOCK_MAX_CONCURRENT_SUBAGENTS:-${config_max_agents:-off}}
OpenAI Fast routes: $openai_fast_policy
Anthropic Fast startup: $anthropic_fast_policy (supported Opus roots only)
EOF
  run_access show
}

validate_default_profile() {
  case "$1" in
    openai|hybrid|grok) ;;
    *)
      printf "airlock: unsupported default profile '%s' (expected openai, hybrid, or grok)\n" "$1" >&2
      return 1
      ;;
  esac
}

resolve_grok_model() {
  case "$1" in
    grok|grok-4.6|grok-4.5) selected_model='grok-4.6'; model_name='Grok 4.6' ;;
    composer|grok-composer|grok-composer-2.5-fast) selected_model='grok-composer-2.5-fast'; model_name='Grok Composer 2.5 Fast' ;;
    *)
      printf "airlock: unsupported Grok model '%s' (expected grok or composer)\n" "$1" >&2
      return 1
      ;;
  esac
}

validate_effort() {
  case "$1" in
    low|medium|high|xhigh|max) ;;
    *)
      printf "airlock: unsupported effort '%s' (expected low, medium, high, xhigh, or max)\n" "$1" >&2
      return 1
      ;;
  esac
}

validate_provider_fast_policy() {
  case "$2" in
    on|off) ;;
    *)
      printf "airlock: unsupported %s Fast policy '%s' (expected on or off)\n" "$1" "$2" >&2
      return 1
      ;;
  esac
}

confirm_anthropic_fast() {
  local answer=''
  case "$extra_usage_policy" in
    allow) return 0 ;;
    never)
      printf 'airlock: Anthropic Fast uses paid usage credits and is blocked by the extra-usage policy.\n' >&2
      return 2
      ;;
    ask)
      if [[ "${AIRLOCK_ANTHROPIC_FAST_AUTHORIZED:-}" == 'yes' ]]; then
        return 0
      fi
      if [[ ! -t 0 ]]; then
        printf 'airlock: Anthropic Fast needs confirmation because it uses paid usage credits. Set AIRLOCK_ANTHROPIC_FAST_AUTHORIZED=yes for this launch or use an interactive terminal.\n' >&2
        return 2
      fi
      printf 'Anthropic Fast uses paid usage credits from the first token. Enable it for this Opus session? [y/N]: ' >&2
      IFS= read -r answer
      case "$answer" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) printf 'airlock: Anthropic Fast launch cancelled.\n' >&2; return 2 ;;
      esac
      ;;
    *)
      printf "airlock: unsupported extra-usage policy '%s'\n" "$extra_usage_policy" >&2
      return 2
      ;;
  esac
}

resolve_model() {
  local requested_model
  requested_model="$(normalize_openai_model_id "$1")"
  case "$requested_model" in
    sol|gpt-5.6-sol) selected_model='gpt-5.6-sol'; model_name='GPT-5.6 Sol' ;;
    sol-fast|gpt-5.6-sol-fast) selected_model='gpt-5.6-sol-fast'; model_name='GPT-5.6 Sol Fast' ;;
    terra|gpt-5.6-terra) selected_model='gpt-5.6-terra'; model_name='GPT-5.6 Terra' ;;
    luna|gpt-5.6-luna) selected_model='gpt-5.6-luna'; model_name='GPT-5.6 Luna' ;;
    5.5|gpt-5.5) selected_model='gpt-5.5'; model_name='GPT-5.5' ;;
    5.4|gpt-5.4) selected_model='gpt-5.4'; model_name='GPT-5.4' ;;
    mini|5.4-mini|gpt-5.4-mini) selected_model='gpt-5.4-mini'; model_name='GPT-5.4 Mini' ;;
    5.3|gpt-5.3-codex) selected_model='gpt-5.3-codex'; model_name='GPT-5.3 Codex' ;;
    spark|5.3-spark|gpt-5.3-codex-spark) selected_model='gpt-5.3-codex-spark'; model_name='GPT-5.3 Codex Spark' ;;
    5.2|gpt-5.2) selected_model='gpt-5.2'; model_name='GPT-5.2' ;;
    *)
      printf "airlock: unsupported model '%s'\n" "$1" >&2
      print_models >&2
      return 1
      ;;
  esac
}

validate_fast_root_model() {
  case "$(normalize_openai_model_id "$1")" in
    gpt-5.6-sol-fast) run_access fast-check --route sol-fast >/dev/null ;;
    gpt-5.6-luna-fast) run_access fast-check --route luna-fast >/dev/null ;;
  esac
}

validate_ephemeral_fast_root() {
  run_access fast-check --route sol-fast --ephemeral >/dev/null
}

model_provider() {
  case "$1" in
    gpt-*) printf 'openai' ;;
    claude-*) printf 'anthropic' ;;
    grok-*) printf 'grok' ;;
    *) return 1 ;;
  esac
}

resolve_hybrid_alias() {
  case "$1" in
    sol|gpt-5.6-sol) root_model='gpt-5.6-sol'; root_name='GPT-5.6 Sol'; root_provider='openai' ;;
    terra|gpt-5.6-terra) root_model='gpt-5.6-terra'; root_name='GPT-5.6 Terra'; root_provider='openai' ;;
    luna|gpt-5.6-luna) root_model='gpt-5.6-luna'; root_name='GPT-5.6 Luna'; root_provider='openai' ;;
    # Claude Code only grants these models their native 1M window when
    # ANTHROPIC_BASE_URL is unset or points at api.anthropic.com, and Airlock
    # always points it at the session router. The [1m] suffix is the one lever
    # that survives that, so it keeps the window these models have natively
    # instead of silently dropping them to 200000. Haiku 4.5 is a genuine
    # 200000 model and must not carry the suffix.
    opus) root_model='claude-opus-5[1m]'; root_name='Claude Opus 5'; root_provider='anthropic' ;;
    sonnet) root_model='claude-sonnet-5[1m]'; root_name='Claude Sonnet 5'; root_provider='anthropic' ;;
    fable) root_model='claude-fable-5[1m]'; root_name='Claude Fable 5'; root_provider='anthropic' ;;
    haiku) root_model='claude-haiku-4-5-20251001'; root_name='Claude Haiku 4.5'; root_provider='anthropic' ;;
    grok|grok-4.6|grok-4.5) root_model='grok-4.6'; root_name='Grok 4.6'; root_provider='grok' ;;
    composer) root_model='grok-composer-2.5-fast'; root_name='Grok Composer 2.5 Fast'; root_provider='grok' ;;
    *) return 1 ;;
  esac
}

openai_model_display() {
  resolve_model "$1" >/dev/null || return 1
  printf '%s (%s)' "$model_name" "$selected_model"
}

# The reserved 'auto' hybrid root resolves at launch time under the local
# access policy: Fable when its access class is neither extra nor unavailable,
# otherwise Opus under the same rule, otherwise Sonnet as a final fallback.
# Auto selection therefore never picks an extra-class model and never creates
# silent metered spend, whatever the extra-usage policy says. The access
# helper owns the rule so both launchers cannot drift; this wrapper only
# validates its output and caches it for reuse within one launch.
resolved_auto_alias=''
resolve_auto_hybrid_root() {
  local resolved=''
  resolved="$(run_access hybrid-default-root)" || return $?
  resolved="${resolved%$'\r'}"
  case "$resolved" in
    fable|opus|sonnet) ;;
    *)
      printf 'airlock: auto hybrid root resolver returned an invalid result.\n' >&2
      return 1
      ;;
  esac
  resolved_auto_alias="$resolved"
}

hybrid_model_display() {
  if [[ "$1" == 'auto' ]]; then
    local alias=''
    alias="$(run_access hybrid-default-root)" || return 1
    alias="${alias%$'\r'}"
    resolve_hybrid_alias "$alias" || return 1
    printf 'auto (resolves now to %s (%s))' "$root_name" "$root_model"
    return 0
  fi
  resolve_hybrid_alias "$1" || return 1
  printf '%s (%s)' "$root_name" "$root_model"
}

health_check() {
  curl --silent --fail --max-time 1 "$proxy_url/healthz" >/dev/null 2>&1
}

prepare_private_proxy_directory() {
  local directory="$1"
  [[ -n "$directory" ]] || return 0
  if [[ -L "$directory" || ( -e "$directory" && ! -d "$directory" ) ]]; then
    printf 'airlock: refusing unsafe proxy data directory.\n' >&2
    return 1
  fi
  if [[ ! -d "$directory" ]]; then
    (umask 077 && mkdir -p "$directory") 2>/dev/null || {
      printf 'airlock: could not create a private writable directory for the proxy.\n' >&2
      return 1
    }
  fi
  [[ -w "$directory" ]] || {
    printf 'airlock: the selected proxy data directory is not writable.\n' >&2
    return 1
  }
}

run_proxy_command() {
  if [[ -n "$proxy_config_dir" && -n "$proxy_state_home" ]]; then
    env CCP_CONFIG_DIR="$proxy_config_dir" XDG_STATE_HOME="$proxy_state_home" claude-code-proxy "$@"
  elif [[ -n "$proxy_config_dir" ]]; then
    env CCP_CONFIG_DIR="$proxy_config_dir" claude-code-proxy "$@"
  elif [[ -n "$proxy_state_home" ]]; then
    env XDG_STATE_HOME="$proxy_state_home" claude-code-proxy "$@"
  else
    claude-code-proxy "$@"
  fi
}

start_proxy_background() {
  local proxy_executable state_home log_dir
  proxy_executable="$(command -v claude-code-proxy || true)"
  [[ -n "$proxy_executable" ]] || return 1
  state_home="${proxy_state_home:-${XDG_STATE_HOME:-$HOME/.local/state}}"
  log_dir="$state_home/claude-code-proxy"
  prepare_private_proxy_directory "$proxy_config_dir" || return 1
  prepare_private_proxy_directory "$state_home" || return 1
  prepare_private_proxy_directory "$log_dir" || return 1
  if [[ -n "$proxy_config_dir" && -n "$proxy_state_home" ]]; then
    nohup env CCP_CONFIG_DIR="$proxy_config_dir" XDG_STATE_HOME="$proxy_state_home" "$proxy_executable" serve --no-monitor >>"$log_dir/service.log" 2>&1 &
  elif [[ -n "$proxy_config_dir" ]]; then
    nohup env CCP_CONFIG_DIR="$proxy_config_dir" "$proxy_executable" serve --no-monitor >>"$log_dir/service.log" 2>&1 &
  elif [[ -n "$proxy_state_home" ]]; then
    nohup env XDG_STATE_HOME="$proxy_state_home" "$proxy_executable" serve --no-monitor >>"$log_dir/service.log" 2>&1 &
  else
    nohup "$proxy_executable" serve --no-monitor >>"$log_dir/service.log" 2>&1 &
  fi
}

start_proxy() {
  local service_file=''
  if [[ -n "$proxy_config_dir" || -n "$proxy_state_home" ]]; then
    case "$(uname -s)" in
      Darwin) service_file="$config_root/claude-code-proxy.plist" ;;
      Linux) service_file="$config_root/claude-code-proxy.service" ;;
    esac
    if command -v brew >/dev/null 2>&1 && [[ -f "$service_file" ]] &&
       grep -qF 'Managed by https://github.com/Harshkamdar67/Airlock' "$service_file"; then
      brew services start claude-code-proxy --file="$service_file" >/dev/null 2>&1 || \
        brew services start raine/claude-code-proxy/claude-code-proxy --file="$service_file" >/dev/null 2>&1 || \
        start_proxy_background
    else
      start_proxy_background
    fi
  elif command -v brew >/dev/null 2>&1; then
    brew services start claude-code-proxy >/dev/null 2>&1 || \
      brew services start raine/claude-code-proxy/claude-code-proxy >/dev/null 2>&1 || true
  else
    start_proxy_background
  fi
  local attempt
  for attempt in $(seq 1 50); do
    health_check && return 0
    sleep 0.1
  done
  return 1
}

ensure_openai_proxy() {
  if [[ "${AIRLOCK_SKIP_HEALTH_CHECK:-0}" != '1' ]] && ! health_check && ! start_proxy; then
    printf 'airlock: proxy did not become healthy at %s/healthz\n' "$proxy_url" >&2
    return 1
  fi
}

# Claude Code decides whether a model supports effort by matching the model ID
# against known Anthropic patterns. A pinned GPT or Grok ID matches nothing,
# which would leave /effort unavailable, so declare the levels explicitly. Only
# do this for non-Claude IDs: declaring capabilities for a real Claude ID would
# disable every capability left off the list, and built-in detection already
# gets those right.
declare_gpt_effort_capabilities() {
  local variable="$1"
  local model="$2"
  case "$model" in
    claude-*|'') return 0 ;;
  esac
  export "${variable}_SUPPORTED_CAPABILITIES=$gpt_effort_capabilities"
}

# Claude Code's auto mode permission classifier hard-codes Claude Sonnet 5 as
# its model and ignores the family slots. On any root that does not serve
# that exact ID the classifier cannot run and every tool call that needs
# classification fails closed. Classifications are frequent background work,
# so point them at the cheapest model this session serves rather than at the
# premium root: the small fast seat first, then the discovery model, then the
# root itself only when nothing smaller is routed. AIRLOCK_AUTO_MODE_MODEL
# passes through verbatim, and off or none keeps Claude Code's native behavior.
apply_auto_mode_model() {
  local root_model="$1"
  local small_model=''
  case "$auto_mode_model" in
    off|none)
      unset CLAUDE_CODE_AUTO_MODE_MODEL
      return 0
      ;;
    ?*)
      export CLAUDE_CODE_AUTO_MODE_MODEL="$auto_mode_model"
      return 0
      ;;
  esac
  case "$root_model" in
    claude-*|'') unset CLAUDE_CODE_AUTO_MODE_MODEL; return 0 ;;
  esac
  small_model="${ANTHROPIC_SMALL_FAST_MODEL:-${ANTHROPIC_DEFAULT_HAIKU_MODEL:-${AIRLOCK_DISCOVERY_MODEL:-}}}"
  if [[ -z "$small_model" ]]; then
    small_model="$root_model"
  fi
  export CLAUDE_CODE_AUTO_MODE_MODEL="$small_model"
}

configure_proxy_model_picker() {
  local profile="$1"
  local raw_models="$2"
  local family family_name model variable
  local fable_model='' opus_model='' sonnet_model='' haiku_model='' count=0
  while IFS='=' read -r family model; do
    model="${model%$'\r'}"
    [[ -n "$family" || -n "$model" ]] || continue
    case "$family" in
      fable) [[ -z "$fable_model" ]] || return 1; fable_model="$model" ;;
      opus) [[ -z "$opus_model" ]] || return 1; opus_model="$model" ;;
      sonnet) [[ -z "$sonnet_model" ]] || return 1; sonnet_model="$model" ;;
      haiku) [[ -z "$haiku_model" ]] || return 1; haiku_model="$model" ;;
      *) return 1 ;;
    esac
    case ",$AIRLOCK_ALLOWED_AGENT_MODELS," in
      *",$model,"*) ;;
      *) return 1 ;;
    esac
    count=$((count + 1))
  done <<<"$raw_models"
  if (( count != 4 )) || [[ -z "$fable_model" || -z "$opus_model" || -z "$sonnet_model" || -z "$haiku_model" ]]; then
    return 1
  fi
  for family in FABLE OPUS SONNET HAIKU; do
    case "$family" in
      FABLE) model="$fable_model"; family_name='Fable' ;;
      OPUS) model="$opus_model"; family_name='Opus' ;;
      SONNET) model="$sonnet_model"; family_name='Sonnet' ;;
      HAIKU) model="$haiku_model"; family_name='Haiku' ;;
    esac
    variable="ANTHROPIC_DEFAULT_${family}_MODEL"
    export "$variable=$model"
    export "${variable}_NAME=$model"
    export "${variable}_DESCRIPTION=Airlock exact route for Claude Code's $family_name slot"
    unset "${variable}_SUPPORTED_CAPABILITIES"
    declare_gpt_effort_capabilities "$variable" "$model"
  done
  if [[ "$profile" == 'grok-pure' || "$profile" == hybrid-* || -z "${ANTHROPIC_SMALL_FAST_MODEL:-}" ]]; then
    export ANTHROPIC_SMALL_FAST_MODEL="$haiku_model"
  fi
}

# Claude Code reads CLAUDE_CODE_AUTO_COMPACT_WINDOW ahead of its own per-model
# tuning, and refuses to let /config change the window while the variable is set.
# Native Anthropic roots already tell Claude Code their real window. Setting the
# variable would cap every named worker in the process too. OpenAI and unknown
# Grok roots keep the conservative saved fallback unless the user overrides it.
# grok-4.6 is documented at 500000; declaring that hard limit and compacting at
# 80% leaves room for the summary request that compaction itself must send.
apply_context_window() {
  local root_provider="$1"
  local root_model="$2"
  if [[ "$root_model" == 'grok-4.6' && "$root_provider" != 'anthropic' ]]; then
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS='500000'
  else
    unset CLAUDE_CODE_MAX_CONTEXT_TOKENS
  fi
  if [[ -n "$user_context_window" ]]; then
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$user_context_window"
    return 0
  fi
  if (( explicit_context_window )); then
    if [[ "$default_context_window" == 'auto' ]]; then
      unset CLAUDE_CODE_AUTO_COMPACT_WINDOW
    else
      export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$default_context_window"
    fi
    return 0
  fi
  if [[ "$default_context_window" == 'auto' || "$root_provider" == 'anthropic' ]]; then
    unset CLAUDE_CODE_AUTO_COMPACT_WINDOW
    return 0
  fi
  if [[ "$root_model" == 'grok-4.6' ]]; then
    export CLAUDE_CODE_AUTO_COMPACT_WINDOW='400000'
    return 0
  fi
  export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$default_context_window"
}

set_openai_environment() {
  local provider_label="${3:-OpenAI subscription}"
  ensure_openai_proxy || exit $?
  unset AIRLOCK_SESSION_ROUTER_URL
  export ANTHROPIC_BASE_URL="$proxy_url"
  export ANTHROPIC_AUTH_TOKEN='unused'
  export ANTHROPIC_MODEL="$1"
  export ANTHROPIC_DEFAULT_FABLE_MODEL="$1"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$1"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$1"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$background_model"
  export ANTHROPIC_SMALL_FAST_MODEL="$background_model"
  export ANTHROPIC_CUSTOM_MODEL_OPTION="$1"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="$2 ($provider_label)"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="Selected Airlock root ($1)"
  declare_gpt_effort_capabilities ANTHROPIC_DEFAULT_FABLE_MODEL "$1"
  declare_gpt_effort_capabilities ANTHROPIC_DEFAULT_OPUS_MODEL "$1"
  declare_gpt_effort_capabilities ANTHROPIC_DEFAULT_SONNET_MODEL "$1"
  declare_gpt_effort_capabilities ANTHROPIC_DEFAULT_HAIKU_MODEL "$background_model"
  declare_gpt_effort_capabilities ANTHROPIC_CUSTOM_MODEL_OPTION "$1"
  # Reached only by the OpenAI-only and Grok-only profiles.
  apply_context_window 'openai' "$1"
  export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT="${CLAUDE_CODE_ALWAYS_ENABLE_EFFORT:-1}"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1'
  export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK='1'
}

clear_proxy_environment() {
  unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL
  unset ANTHROPIC_DEFAULT_FABLE_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL
  unset ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
  unset ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_CUSTOM_MODEL_OPTION
  unset ANTHROPIC_DEFAULT_FABLE_MODEL_NAME ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION
  unset ANTHROPIC_DEFAULT_OPUS_MODEL_NAME ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION
  unset ANTHROPIC_DEFAULT_SONNET_MODEL_NAME ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION
  unset ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION
  unset ANTHROPIC_CUSTOM_MODEL_OPTION_NAME ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION
  unset ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES
  unset ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES
  unset ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES
  unset ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES
  unset ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES
  unset CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_MAX_CONTEXT_TOKENS
  unset CLAUDE_CODE_ALWAYS_ENABLE_EFFORT
  unset CLAUDE_CODE_AUTO_MODE_MODEL
  unset CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK
  unset CLAUDE_CODE_SUBAGENT_MODEL AIRLOCK_SESSION_ROUTER_URL
}

native_owner_pid() {
  local owner_pid="$$"
  local listed_pid listed_ppid listed_pgid listed_winpid remainder
  if [[ "$OSTYPE" == msys* || "$OSTYPE" == cygwin* ]]; then
    owner_pid=''
    while read -r listed_pid listed_ppid listed_pgid listed_winpid remainder; do
      if [[ "$listed_pid" == "$$" && "$listed_winpid" =~ ^[1-9][0-9]*$ ]]; then
        owner_pid="$listed_winpid"
        break
      fi
    done < <(ps -p "$$" -l)
  fi
  if [[ ! "$owner_pid" =~ ^[1-9][0-9]*$ ]]; then
    return 1
  fi
  printf '%s\n' "$owner_pid"
}

set_hybrid_environment() {
  local root_model="$1"
  local root_name="$2"
  local snapshot_path="$3"
  local snapshot_digest="$4"
  local root_profile="$5"
  local router_url router_owner_pid root_provider
  case "$root_profile" in
    hybrid-anthropic-root) root_provider='anthropic' ;;
    hybrid-grok-root) root_provider='grok' ;;
    hybrid-openrouter-root) root_provider='openrouter' ;;
    *) root_provider='openai' ;;
  esac
  if [[ -n "${ANTHROPIC_API_KEY:-}" || ( -n "${ANTHROPIC_AUTH_TOKEN:-}" && "${ANTHROPIC_AUTH_TOKEN}" != 'unused' ) ]]; then
    printf 'airlock: hybrid native routing requires saved Claude subscription login without ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN.\n' >&2
    return 1
  fi
  if [[ ! -f "$router_helper" || -L "$router_helper" ]]; then
    printf 'airlock: managed router helper is missing or unsafe: %s\n' "$router_helper" >&2
    return 1
  fi
  ensure_openai_proxy || return $?
  clear_proxy_environment
  # OpenRouter credentials are loaded by the loopback router from protected
  # storage and never belong in any Claude Code child process.
  unset OPENROUTER_API_KEY
  if [[ "$root_profile" == 'hybrid-openrouter-root' ]]; then
    # An OpenRouter hybrid root must not expose unrelated provider credentials
    # to the Claude Code child process either.
    unset CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY
    unset XAI_API_KEY GROK_API_KEY
  fi
  router_owner_pid="$(native_owner_pid)" || {
    printf 'airlock: could not determine the native launcher process ID.\n' >&2
    return 1
  }
  router_url="$("$python_bin" "$router_helper" start \
    --parent-pid "$router_owner_pid" \
    --snapshot "$snapshot_path" \
    --snapshot-sha256 "$snapshot_digest" \
    --openai-url "$proxy_url")" || return $?
  if [[ ! "$router_url" =~ ^http://127\.0\.0\.1:[1-9][0-9]*$ ]]; then
    printf 'airlock: native hybrid router returned an invalid loopback address.\n' >&2
    return 1
  fi
  export ANTHROPIC_BASE_URL="$router_url"
  export AIRLOCK_SESSION_ROUTER_URL="$router_url"
  export ANTHROPIC_CUSTOM_MODEL_OPTION="$root_model"
  if [[ "$root_profile" == 'hybrid-openrouter-root' ]]; then
    export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="$root_name (OpenRouter hybrid root)"
    export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="Selected OpenRouter hybrid root ($root_model)"
  else
    export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="$root_name (native hybrid route)"
    export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="Selected Airlock hybrid root ($root_model)"
  fi
  declare_gpt_effort_capabilities ANTHROPIC_CUSTOM_MODEL_OPTION "$root_model"
  apply_context_window "$root_provider" "$root_model"
  export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT="${CLAUDE_CODE_ALWAYS_ENABLE_EFFORT:-1}"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1'
  export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK='1'
}

set_openrouter_environment() {
  local root_model="$1"
  local root_name="$2"
  local snapshot_path="$3"
  local snapshot_digest="$4"
  local router_url router_owner_pid
  if [[ ! -f "$router_helper" || -L "$router_helper" ]]; then
    printf 'airlock: managed router helper is missing or unsafe: %s\n' "$router_helper" >&2
    return 1
  fi
  clear_proxy_environment
  unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
  unset OPENAI_API_KEY CODEX_API_KEY XAI_API_KEY GROK_API_KEY OPENROUTER_API_KEY
  router_owner_pid="$(native_owner_pid)" || {
    printf 'airlock: could not determine the native launcher process ID.\n' >&2
    return 1
  }
  router_url="$("$python_bin" "$router_helper" start \
    --parent-pid "$router_owner_pid" \
    --snapshot "$snapshot_path" \
    --snapshot-sha256 "$snapshot_digest")" || return $?
  if [[ ! "$router_url" =~ ^http://127\.0\.0\.1:[1-9][0-9]*$ ]]; then
    printf 'airlock: native OpenRouter router returned an invalid loopback address.\n' >&2
    return 1
  fi
  export ANTHROPIC_BASE_URL="$router_url"
  export AIRLOCK_SESSION_ROUTER_URL="$router_url"
  export ANTHROPIC_AUTH_TOKEN='unused'
  export ANTHROPIC_MODEL="$root_model"
  export ANTHROPIC_DEFAULT_FABLE_MODEL="$root_model"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$root_model"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$root_model"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$root_model"
  export ANTHROPIC_SMALL_FAST_MODEL="$root_model"
  export ANTHROPIC_CUSTOM_MODEL_OPTION="$root_model"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="$root_name (OpenRouter route)"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION="Selected exact OpenRouter root ($root_model)"
  declare_gpt_effort_capabilities ANTHROPIC_CUSTOM_MODEL_OPTION "$root_model"
  export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT="${CLAUDE_CODE_ALWAYS_ENABLE_EFFORT:-1}"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='1'
  export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK='1'
}

compose_append_system_prompt() {
  local guidance="$1"
  shift
  local custom='' value combined
  local have_custom=0
  AIRLOCK_COMPOSED_CLAUDE_ARGS=()
  while (( $# )); do
    case "$1" in
      --append-system-prompt)
        if (( $# < 2 )); then
          printf 'airlock: --append-system-prompt requires a value.\n' >&2
          return 2
        fi
        value="$2"
        shift 2
        ;;
      --append-system-prompt=*)
        value="${1#--append-system-prompt=}"
        shift
        ;;
      *)
        AIRLOCK_COMPOSED_CLAUDE_ARGS+=("$1")
        shift
        continue
        ;;
    esac
    if (( have_custom )); then
      custom+=$'\n\n'"$value"
    else
      custom="$value"
      have_custom=1
    fi
  done
  combined="$guidance"
  if (( have_custom )) && [[ -n "$custom" ]]; then
    combined="$custom"$'\n\n'"$guidance"
  fi
  # The composed text reaches Claude through --append-system-prompt-file so
  # long routing guidance never rides in the process argument list.
  AIRLOCK_COMBINED_SYSTEM_PROMPT="$combined"
}

run_claude_with_stable_owner() {
  local child_pid='' child_status=0
  trap '[[ -z "$child_pid" ]] || kill -INT "$child_pid" 2>/dev/null || true' INT
  trap '[[ -z "$child_pid" ]] || kill -TERM "$child_pid" 2>/dev/null || true' TERM
  trap '[[ -z "$child_pid" ]] || kill -HUP "$child_pid" 2>/dev/null || true' HUP
  # A background command in a non-interactive Bash script can otherwise receive
  # /dev/null on stdin. Preserve the launcher's original input explicitly so the
  # Claude TUI does not depend on incidental shell redirection state. If the
  # caller deliberately closed stdin, preserve that behavior as end-of-file.
  if (exec 9<&0) 2>/dev/null; then
    exec 9<&0
  else
    exec 9</dev/null
  fi
  "$@" <&9 9<&- &
  child_pid=$!
  exec 9<&-
  while true; do
    if wait "$child_pid"; then
      child_status=0
      break
    else
      child_status=$?
    fi
    if ! kill -0 "$child_pid" 2>/dev/null; then
      break
    fi
  done
  trap - INT TERM HUP
  return "$child_status"
}

launch_session() {
  local profile="$1"
  local session_model="$2"
  local session_name="$3"
  local openrouter_root_route="$4"
  shift 4
  local argument max_agents
  local -a openrouter_root_args=()
  if [[ "$profile" == 'openrouter-pure' || "$profile" == 'hybrid-openrouter-root' ]]; then
    if [[ -z "$openrouter_root_route" ]]; then
      printf 'airlock: %s requires an exact OpenRouter root route.\n' "$profile" >&2
      exit 2
    fi
    openrouter_root_args=(--openrouter-root-route "$openrouter_root_route")
  elif [[ -n "$openrouter_root_route" ]]; then
    printf 'airlock: an OpenRouter root route is valid only for openrouter-pure or hybrid-openrouter-root.\n' >&2
    exit 2
  fi
  for argument in "$@"; do
    case "$argument" in
      --safe-mode|--bare|--agent|--agents|--plugin-dir|--plugin-url|--settings|--safe-mode=*|--bare=*|--agent=*|--agents=*|--plugin-dir=*|--plugin-url=*|--settings=*)
        printf 'airlock: %s is managed or incompatible with the Airlock worker guard and cannot be forwarded.\n' "$argument" >&2
        exit 2
        ;;
    esac
  done
  if [[ "${CLAUDE_CODE_SAFE_MODE:-0}" == '1' || "${CLAUDE_CODE_SIMPLE:-0}" == '1' ]]; then
    printf 'airlock: CLAUDE_CODE_SAFE_MODE/CLAUDE_CODE_SIMPLE would disable managed session protection; unset it before launching.\n' >&2
    exit 2
  fi
  validate_managed_bundle || exit $?
  if [[ ! -d "$plugin_dir" || -L "$plugin_dir" || ! -f "$plugin_dir/.claude-plugin/plugin.json" ]]; then
    printf 'airlock: managed session plugin is missing or unsafe: %s\n' "$plugin_dir" >&2
    exit 1
  fi
  max_agents="${AIRLOCK_MAX_CONCURRENT_SUBAGENTS:-${config_max_agents:-off}}"
  if [[ "$max_agents" == 'off' ]]; then
    unset CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS
  elif [[ "$max_agents" =~ ^[1-9][0-9]?$ ]] && (( max_agents <= 20 )); then
    export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS="$max_agents"
  else
    printf "airlock: invalid max-agent setting '%s' (expected off or 1..20)\n" "$max_agents" >&2
    exit 2
  fi
  unset CLAUDE_CODE_SUBAGENT_MODEL
  agent_depth="${AIRLOCK_AGENT_DEPTH:-${config_agent_depth:-1}}"
  if [[ ! "$agent_depth" =~ ^[12]$ ]]; then
    printf "airlock: invalid agent depth '%s' (expected 1 or 2)
" "$agent_depth" >&2
    exit 2
  fi
  export CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH="$agent_depth"
  export AIRLOCK_AGENT_DEPTH="$agent_depth"
  export AIRLOCK_ACTIVE_PROFILE="$profile"
  export AIRLOCK_UPDATE_NOTICE_FILE="$update_notice_file"
  local agents_json guidance claude_bin managed_agent_output agent_name session_settings fast_mode agent_depth
  local route_agent_names allowed_model_ids extra_agent_names extra_model_ids picker_models discovery_model
  local snapshot_output snapshot_path snapshot_digest snapshot_extra
  local transition_output transition_channel transition_nonce transition_session_id
  local transition_status launcher_pid launch_cwd handoff_effort
  local -a skill_guard=() allowed_tools=('Agent(Explore)' 'Agent(Plan)' 'Agent(general-purpose)') enabled_agents=()
  if [[ "${AIRLOCK_ALLOW_CLAUDE_API_SKILL:-0}" != '1' ]]; then
    skill_guard=(--disallowedTools 'Skill(claude-api)' 'Skill(claude-api *)')
  fi
  agents_json="$(run_access render-profile --profile "$profile" \
    ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} \
    --openai-direct-file "$openai_direct_agents_file" \
    --anthropic-direct-file "$anthropic_direct_agents_file" \
    --openai-wrappers-file "$openai_wrapper_agents_file" \
    --anthropic-wrappers-file "$anthropic_wrapper_agents_file" \
    --grok-direct-file "$grok_direct_agents_file" \
    --grok-wrappers-file "$grok_wrapper_agents_file")"
  managed_agent_output="$(run_access managed-agent-names --agents-json "$agents_json")" || exit $?
  if [[ -z "$managed_agent_output" ]]; then
    printf 'airlock: rendered worker profile did not produce an exact Agent permission set.\n' >&2
    exit 1
  fi
  while IFS= read -r agent_name; do
    agent_name="${agent_name%$'\r'}"
    [[ -n "$agent_name" ]] || continue
    enabled_agents+=("$agent_name")
    allowed_tools+=("Agent($agent_name)")
  done <<<"$managed_agent_output"
  if (( ${#enabled_agents[@]} == 0 )); then
    printf 'airlock: rendered worker profile did not produce an exact Agent permission set.\n' >&2
    exit 1
  fi
  AIRLOCK_ALLOWED_AGENT_NAMES="$(IFS=,; printf '%s' "${enabled_agents[*]}")"
  route_agent_names="$(run_access session-routes --profile "$profile" ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} --field agent-names)" || exit $?
  if [[ "$route_agent_names" != "$AIRLOCK_ALLOWED_AGENT_NAMES" ]]; then
    printf 'airlock: rendered native Agents do not match the session route policy.\n' >&2
    exit 1
  fi
  allowed_model_ids="$(run_access session-routes --profile "$profile" ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} --field model-ids)" || exit $?
  extra_agent_names="$(run_access session-routes --profile "$profile" ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} --field extra-agent-names)" || exit $?
  extra_model_ids="$(run_access session-routes --profile "$profile" ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} --field extra-model-ids)" || exit $?
  picker_models="$(run_access session-routes --profile "$profile" ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} --field picker-models)" || exit $?
  discovery_model="$(run_access session-routes --profile "$profile" ${openrouter_root_args[@]+"${openrouter_root_args[@]}"} --field discovery-model)" || exit $?
  if [[ -z "$allowed_model_ids" ]]; then
    printf 'airlock: native session model route policy is empty.\n' >&2
    exit 1
  fi
  export AIRLOCK_ALLOWED_AGENT_NAMES
  export AIRLOCK_ALLOWED_AGENT_MODELS="$allowed_model_ids"
  export AIRLOCK_EXTRA_USAGE_AGENT_NAMES="$extra_agent_names"
  export AIRLOCK_EXTRA_USAGE_AGENT_MODELS="$extra_model_ids"
  export AIRLOCK_ROOT_MODEL="$session_model"
  if [[ -n "$discovery_model" ]]; then
    export AIRLOCK_DISCOVERY_MODEL="$discovery_model"
  else
    unset AIRLOCK_DISCOVERY_MODEL
  fi
  if [[ "$profile" == hybrid-* || "$profile" == 'openrouter-pure' ]]; then
    case ",$allowed_model_ids," in
      *",$session_model,"*) ;;
      *)
        printf "airlock: session root model '%s' is not enabled by the active route policy.\n" "$session_model" >&2
        exit 2
        ;;
    esac
  fi
  fast_mode='off'
  # The root model carries a [1m] suffix on the models that need it, so this
  # gate has to compare the base name rather than the whole string.
  if [[ "${session_model%\[1m\]}" == 'claude-opus-5' && "$anthropic_fast_policy" == 'on' ]]; then
    confirm_anthropic_fast || exit $?
    fast_mode='on'
  fi
  session_settings="$(run_access managed-session-settings --agents-json "$agents_json" --fast-mode "$fast_mode" \
    --web-tools-script "$plugin_dir/mcp-server/airlock_web_tools.py" \
    --profile "$profile")" || exit $?
  guidance="$(run_access profile-guidance --profile "$profile" \
    --web-tools-script "$plugin_dir/mcp-server/airlock_web_tools.py" \
    ${openrouter_root_args[@]+"${openrouter_root_args[@]}"})"
  claude_bin="${AIRLOCK_REAL_CLAUDE:-}"
  [[ -n "$claude_bin" ]] || claude_bin="$(command -v claude || true)"
  if [[ -z "$claude_bin" ]]; then
    printf 'airlock: Claude Code is missing. Set AIRLOCK_REAL_CLAUDE or install Claude Code.\n' >&2
    exit 1
  fi
  compose_append_system_prompt "$guidance" "$@" || exit $?
  snapshot_output="$(run_access session-snapshot \
    --profile "$profile" --root-model "$session_model" \
    ${openrouter_root_args[@]+"${openrouter_root_args[@]}"})" || exit $?
  if [[ "$snapshot_output" == *$'\n'* || "$snapshot_output" != *$'\t'* ]]; then
    printf 'airlock: session policy snapshot helper returned an invalid result.\n' >&2
    exit 1
  fi
  snapshot_path="${snapshot_output%%$'\t'*}"
  snapshot_digest="${snapshot_output#*$'\t'}"
  if [[ -z "$snapshot_path" || "$snapshot_digest" == *$'\t'* || \
        ${#snapshot_digest} -ne 64 || "$snapshot_digest" =~ [^0-9a-f] ]]; then
    printf 'airlock: session policy snapshot helper returned an invalid result.\n' >&2
    exit 1
  fi
  if [[ ! -f "$snapshot_path" || -L "$snapshot_path" ]]; then
    printf 'airlock: session policy snapshot is missing or unsafe.\n' >&2
    exit 1
  fi
  if [[ ! -f "$policy_helper" || -L "$policy_helper" ]]; then
    run_access session-snapshot-delete \
      --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
      >/dev/null 2>&1 || true
    printf 'airlock: managed policy helper is missing or unsafe: %s\n' "$policy_helper" >&2
    exit 1
  fi
  export AIRLOCK_POLICY_HELPER="$policy_helper"
  export AIRLOCK_ACCESS_HELPER="$access_helper"
  export AIRLOCK_SESSION_SNAPSHOT="$snapshot_path"
  export AIRLOCK_SESSION_SNAPSHOT_SHA256="$snapshot_digest"
  if [[ "$profile" == hybrid-* ]]; then
    if set_hybrid_environment \
      "$session_model" "$session_name" "$snapshot_path" "$snapshot_digest" "$profile"; then
      :
    else
      snapshot_extra=$?
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      exit "$snapshot_extra"
    fi
  elif [[ "$profile" == 'openrouter-pure' ]]; then
    if set_openrouter_environment \
      "$session_model" "$session_name" "$snapshot_path" "$snapshot_digest"; then
      :
    else
      snapshot_extra=$?
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      exit "$snapshot_extra"
    fi
  fi
  if ! configure_proxy_model_picker "$profile" "$picker_models"; then
    run_access session-snapshot-delete \
      --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
      >/dev/null 2>&1 || true
    printf 'airlock: %s model picker map is invalid.\n' "$profile" >&2
    exit 1
  fi
  # The classifier seat is chosen after the picker so a hybrid or OpenRouter
  # profile can ride the small model the picker seated rather than its root.
  apply_auto_mode_model "$session_model"
  transition_channel=''
  transition_nonce=''
  launcher_pid=''
  launch_cwd=''
  if (( airlock_fast_handoff_hop == 0 )); then
    launcher_pid="$(native_owner_pid)" || {
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      printf 'airlock: could not determine the native launcher process ID for Fast handoff.\n' >&2
      exit 1
    }
    launch_cwd="$(pwd -P)" || {
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      printf 'airlock: could not resolve the session working directory for Fast handoff.\n' >&2
      exit 1
    }
    if transition_output="$(run_access fast-transition-create \
      --launcher-pid "$launcher_pid" --cwd "$launch_cwd")"; then
      :
    else
      transition_status=$?
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      exit "$transition_status"
    fi
    if [[ "$transition_output" != *$'\t'* || "$transition_output" == *$'\n'* ]]; then
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      printf 'airlock: Fast handoff helper returned invalid channel metadata.\n' >&2
      exit 1
    fi
    transition_channel="${transition_output%%$'\t'*}"
    transition_nonce="${transition_output#*$'\t'}"
    if [[ -z "$transition_channel" || -z "$transition_nonce" || "$transition_nonce" == *$'\t'* ]]; then
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      printf 'airlock: Fast handoff helper returned invalid channel metadata.\n' >&2
      exit 1
    fi
    export AIRLOCK_FAST_TRANSITION_CHANNEL="$transition_channel"
    export AIRLOCK_FAST_TRANSITION_NONCE="$transition_nonce"
  else
    unset AIRLOCK_FAST_TRANSITION_CHANNEL AIRLOCK_FAST_TRANSITION_NONCE
  fi
  # Windows rejects an exec once quoted argv plus environment cross its
  # command-line ceiling, and Claude Code does not start mcpServers entries
  # carried in --settings on every supported version. Settings, composed
  # guidance, and the web tools server therefore reach Claude as real
  # artifact files, staged last so no earlier failure path can leak them.
  local -a file_backed_args=()
  local -a mcp_config_args=()
  local artifact_output='' artifact_rest=''
  local settings_path='' settings_digest='' settings_size=''
  local prompt_path='' prompt_digest='' prompt_size=''
  local mcp_file_output='' mcp_config_rest=''
  local mcp_config_path='' mcp_config_digest='' mcp_config_size=''
  stage_managed_session_artifact() {
    if ! artifact_output="$(printf '%s' "$1" | run_access session-artifact-create --prefix "$2" --suffix "$3")"; then
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      printf 'airlock: %s could not be staged.\n' "$4" >&2
      return 1
    fi
    artifact_a_path="${artifact_output%%$'\t'*}"
    artifact_rest="${artifact_output#*$'\t'}"
    artifact_a_digest="${artifact_rest%%$'\t'*}"
    artifact_a_size="${artifact_rest#*$'\t'}"
    if [[ -z "$artifact_a_path" || ${#artifact_a_digest} -ne 64 || \
          "$artifact_a_digest" =~ [^0-9a-f] || -z "$artifact_a_size" || \
          "$artifact_a_size" =~ [^0-9] ]]; then
      run_access session-snapshot-delete \
        --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
        >/dev/null 2>&1 || true
      printf 'airlock: %s staging returned an invalid result.\n' "$4" >&2
      return 1
    fi
  }
  local artifact_a_path='' artifact_a_digest='' artifact_a_size=''
  stage_managed_session_artifact \
    "$session_settings" 'settings-' '.json' 'managed session settings' || exit 1
  settings_path="$artifact_a_path"
  settings_digest="$artifact_a_digest"
  settings_size="$artifact_a_size"
  file_backed_args+=(--settings "$settings_path")
  stage_managed_session_artifact \
    "$AIRLOCK_COMBINED_SYSTEM_PROMPT" 'guidance-' '.txt' 'routing guidance' || exit 1
  prompt_path="$artifact_a_path"
  prompt_digest="$artifact_a_digest"
  prompt_size="$artifact_a_size"
  file_backed_args+=(--append-system-prompt-file "$prompt_path")
  if mcp_file_output="$(run_access managed-web-tools-mcp-file \
      --web-tools-script "$plugin_dir/mcp-server/airlock_web_tools.py" \
      --profile "$profile")"; then
    if [[ -n "$mcp_file_output" ]]; then
      mcp_config_path="${mcp_file_output%%$'\t'*}"
      mcp_config_rest="${mcp_file_output#*$'\t'}"
      mcp_config_digest="${mcp_config_rest%%$'\t'*}"
      mcp_config_size="${mcp_config_rest#*$'\t'}"
      if [[ -z "$mcp_config_path" || -z "$mcp_config_digest" || \
            ${#mcp_config_digest} -ne 64 || "$mcp_config_digest" =~ [^0-9a-f] || \
            -z "$mcp_config_size" || "$mcp_config_size" =~ [^0-9] ]]; then
        run_access session-snapshot-delete \
          --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
          >/dev/null 2>&1 || true
        printf 'airlock: web tools MCP config helper returned an invalid result.\n' >&2
        exit 1
      fi
      mcp_config_args=(--mcp-config "$mcp_config_path")
    fi
  else
    run_access session-snapshot-delete \
      --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
      >/dev/null 2>&1 || true
    printf 'airlock: web tools MCP config could not be created.\n' >&2
    exit 1
  fi
  # skill_guard is empty when the claude-api skill is allowed. Bash 3.2, which
  # is what macOS still ships as /bin/bash, treats "${array[@]}" on an empty
  # array as an unbound variable under set -u, so every expansion that can be
  # empty uses the ${array[@]+...} form. Bash 4 and later behave identically.
  local -a claude_command=(
    "$claude_bin" --plugin-dir "$plugin_dir"
    ${file_backed_args[@]+"${file_backed_args[@]}"}
    --agents "$agents_json" --allowedTools "${allowed_tools[@]}"
    ${mcp_config_args[@]+"${mcp_config_args[@]}"}
    ${skill_guard[@]+"${skill_guard[@]}"} "${AIRLOCK_COMPOSED_CLAUDE_ARGS[@]}"
  )
  if run_claude_with_stable_owner "${claude_command[@]}"; then
    snapshot_extra=0
  else
    snapshot_extra=$?
  fi
  local cleanup_target='' cleanup_path=''
  local cleanup_rest='' cleanup_digest='' cleanup_size=''
  for cleanup_target in \
    "$settings_path"$'\t'"$settings_digest"$'\t'"$settings_size" \
    "$prompt_path"$'\t'"$prompt_digest"$'\t'"$prompt_size"; do
    cleanup_path="${cleanup_target%%$'\t'*}"
    cleanup_rest="${cleanup_target#*$'\t'}"
    cleanup_digest="${cleanup_rest%%$'\t'*}"
    cleanup_size="${cleanup_rest#*$'\t'}"
    if [[ -n "$cleanup_path" ]] && ! run_access session-artifact-delete \
        --artifact "$cleanup_path" --digest "$cleanup_digest" \
        --size "$cleanup_size" >/dev/null 2>&1; then
      printf 'airlock: warning: managed session file cleanup failed: %s\n' \
        "$cleanup_path" >&2
    fi
  done
  if [[ -n "$mcp_config_path" ]]; then
    if ! run_access session-artifact-delete \
        --artifact "$mcp_config_path" --digest "$mcp_config_digest" \
        --size "$mcp_config_size" >/dev/null 2>&1; then
      printf 'airlock: warning: web tools MCP config cleanup failed: %s\n' \
        "$mcp_config_path" >&2
    fi
  fi
  if ! run_access session-snapshot-delete \
    --snapshot "$snapshot_path" --snapshot-sha256 "$snapshot_digest" \
    >/dev/null; then
    printf 'airlock: warning: session policy snapshot cleanup failed: %s\n' \
      "$snapshot_path" >&2
  fi
  unset AIRLOCK_SESSION_SNAPSHOT AIRLOCK_SESSION_SNAPSHOT_SHA256
  if [[ -z "$transition_channel" ]]; then
    return "$snapshot_extra"
  fi
  unset AIRLOCK_FAST_TRANSITION_CHANNEL AIRLOCK_FAST_TRANSITION_NONCE
  if (( snapshot_extra != 0 )); then
    run_access fast-transition-cleanup --launcher-pid "$launcher_pid" \
      --cwd "$launch_cwd" --channel "$transition_channel" \
      --nonce "$transition_nonce" >/dev/null 2>&1 || true
    return "$snapshot_extra"
  fi
  if transition_session_id="$(run_access fast-transition-consume --if-ready \
    --launcher-pid "$launcher_pid" --cwd "$launch_cwd" \
    --channel "$transition_channel" --nonce "$transition_nonce")"; then
    :
  else
    transition_status=$?
    run_access fast-transition-cleanup --launcher-pid "$launcher_pid" \
      --cwd "$launch_cwd" --channel "$transition_channel" \
      --nonce "$transition_nonce" >/dev/null 2>&1 || true
    return "$transition_status"
  fi
  run_access fast-transition-cleanup --launcher-pid "$launcher_pid" \
    --cwd "$launch_cwd" --channel "$transition_channel" \
    --nonce "$transition_nonce" >/dev/null 2>&1 || true
  if [[ -z "$transition_session_id" ]]; then
    return 0
  fi
  validate_ephemeral_fast_root || return $?
  resolve_model 'sol-fast'
  set_openai_environment "$selected_model" "$model_name"
  unset AIRLOCK_HYBRID AIRLOCK_GPT_HYBRID AIRLOCK_GROK_HYBRID AIRLOCK_OPENROUTER_HYBRID
  handoff_effort="${AIRLOCK_MAIN_EFFORT:-${config_main_effort:-high}}"
  validate_effort "$handoff_effort"
  airlock_fast_handoff_hop=1
  printf 'airlock: resuming this conversation with OpenAI Fast.\n' >&2
  launch_session openai-pure "$selected_model" "$model_name" '' \
    --model "$selected_model" --effort "$handoff_effort" \
    --resume "$transition_session_id"
  return $?
}

select_hybrid_root() {
  if [[ ! -t 0 ]]; then
    printf 'airlock: hybrid choose needs an interactive terminal; otherwise use airlock hybrid MODEL\n' >&2
    exit 2
  fi
  printf '%s\n' \
    'Choose the Airlock hybrid orchestrator:' \
    '  1) Claude Sonnet 5 (claude-sonnet-5[1m])' \
    '  2) GPT-5.6 Sol (gpt-5.6-sol)' \
    '  3) GPT-5.6 Terra (gpt-5.6-terra)' \
    '  4) GPT-5.6 Luna (gpt-5.6-luna)' \
    '  5) Claude Opus 5 (claude-opus-5[1m])' \
    '  6) Claude Fable 5 (claude-fable-5[1m]; may use extra usage)' \
    '  7) Claude Haiku 4.5 (claude-haiku-4-5-20251001)' \
    '  8) Grok 4.6 (grok-4.6; requires Grok OAuth)' \
    '  9) Grok Composer 2.5 Fast (grok-composer-2.5-fast; requires Grok OAuth)' \
    ' 10) An exact OpenRouter registry route'
  read -r -p 'Selection [1-10]: ' selection
  case "$selection" in
    1) root_alias='sonnet' ;; 2) root_alias='sol' ;; 3) root_alias='terra' ;; 4) root_alias='luna' ;;
    5) root_alias='opus' ;; 6) root_alias='fable' ;; 7) root_alias='haiku' ;;
    8) root_alias='grok' ;; 9) root_alias='composer' ;;
    10)
      select_openrouter_root || exit $?
      resolve_openrouter_root "$OPR_SELECTED_ROUTE" || exit $?
      HYBRID_SELECTED_ROUTE="$OPR_SELECTED_ROUTE"
      ;;
    *) printf 'airlock: invalid hybrid root selection. Enter a number from 1 to 10.\n' >&2; exit 2 ;;
  esac
}

resolve_openrouter_root() {
  local requested_route="$1"
  local route_json parsed resolved_route resolved_model endpoint_provider provider_name provider_slug quantization canonical_slug
  route_json="$(run_access openrouter-resolve "$requested_route")" || return $?
  parsed="$("$python_bin" -c '
import json, sys
try:
    value = json.load(sys.stdin)
    keys = ("route", "model", "endpoint_provider", "provider_name", "provider_slug", "quantization", "canonical_slug")
    if not isinstance(value, dict) or any(not isinstance(value.get(key), str) or not value[key] for key in keys):
        raise ValueError
    print("\t".join(value[key] for key in keys))
except Exception:
    raise SystemExit(1)
' <<<"$route_json")" || {
    printf 'airlock: OpenRouter route resolver returned an invalid result.\n' >&2
    return 1
  }
  IFS=$'\t' read -r resolved_route resolved_model endpoint_provider provider_name provider_slug quantization canonical_slug <<<"$parsed"
  if [[ "$resolved_route" != "$requested_route" || -z "$resolved_model" || -z "$endpoint_provider" || \
        -z "$provider_name" || -z "$provider_slug" || -z "$quantization" || -z "$canonical_slug" ]]; then
    printf 'airlock: OpenRouter route resolver returned an invalid result.\n' >&2
    return 1
  fi
  OPR_SELECTED_ROUTE="$resolved_route"
  OPR_ROOT_MODEL="$resolved_model"
  OPR_ROOT_NAME="OpenRouter $resolved_route"
}

select_openrouter_root() {
  local routes_json parsed selection route model endpoint provider quantization
  local -a routes=() models=() endpoints=()
  if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'airlock: an OpenRouter route is required outside an interactive terminal; use airlock opr ROUTE.\n' >&2
    return 2
  fi
  routes_json="$(run_access openrouter-routes)" || return $?
  parsed="$("$python_bin" -c '
import json, sys
try:
    values = json.load(sys.stdin)
    if not isinstance(values, list):
        raise ValueError
    keys = ("route", "model", "endpoint_provider", "provider_slug", "quantization")
    for value in values:
        if not isinstance(value, dict) or any(not isinstance(value.get(key), str) or not value[key] for key in keys):
            raise ValueError
        print("\t".join(value[key] for key in keys))
except Exception:
    raise SystemExit(1)
' <<<"$routes_json")" || {
    printf 'airlock: OpenRouter route list returned an invalid result.\n' >&2
    return 1
  }
  while IFS=$'\t' read -r route model endpoint provider quantization; do
    [[ -n "$route" && -n "$model" && -n "$endpoint" && -n "$provider" && -n "$quantization" ]] || continue
    routes+=("$route")
    models+=("$model")
    endpoints+=("$endpoint; $provider/$quantization")
  done <<<"$parsed"
  if (( ${#routes[@]} == 0 )); then
    printf 'airlock: no enabled OpenRouter routes are available; add one with airlock openrouter models add or add-preset.\n' >&2
    return 2
  fi
  printf 'Choose the exact OpenRouter root route:\n'
  for ((selection=0; selection<${#routes[@]}; selection++)); do
    printf '  %d) %s (%s; %s)\n' \
      "$((selection + 1))" "${routes[$selection]}" "${models[$selection]}" "${endpoints[$selection]}"
  done
  read -r -p "Selection [1-${#routes[@]}]: " selection
  if [[ ! "$selection" =~ ^[1-9][0-9]*$ ]] || (( selection > ${#routes[@]} )); then
    printf 'airlock: invalid OpenRouter route selection.\n' >&2
    return 2
  fi
  OPR_SELECTED_ROUTE="${routes[$((selection - 1))]}"
}

validate_default_profile "$default_profile" || exit $?
validate_provider_fast_policy OpenAI "$openai_fast_policy" || exit $?
validate_provider_fast_policy Anthropic "$anthropic_fast_policy" || exit $?
# Eager saved-value validation runs on every invocation, exactly as before.
# The reserved 'auto' value is validated through the access helper instead of
# the alias table; the resolved alias is cached for the hybrid branch below.
if [[ "$default_hybrid_model" == 'auto' ]]; then
  resolve_auto_hybrid_root || exit $?
elif ! resolve_hybrid_alias "$default_hybrid_model"; then
  printf "airlock: unsupported saved hybrid model '%s'\n" "$default_hybrid_model" >&2
  exit 2
fi
if ! resolve_model "$default_openai_model" >/dev/null 2>&1; then
  printf "airlock: unsupported saved OpenAI model '%s'\n" "$default_openai_model" >&2
  exit 2
fi
if ! resolve_model "$default_bg_model" >/dev/null 2>&1; then
  printf "airlock: unsupported saved background model '%s'\n" "$default_bg_model" >&2
  exit 2
fi
if ! resolve_grok_model "$default_grok_model" >/dev/null 2>&1; then
  printf "airlock: unsupported saved Grok model '%s'\n" "$default_grok_model" >&2
  exit 2
fi
if [[ "${1:-}" == 'orp' ]]; then
  printf "airlock: command 'orp' was renamed to 'opr'; use airlock opr.\n" >&2
  exit 2
fi
if [[ "$default_profile" == 'hybrid' ]]; then
  case "${1:-}" in
    mode|usage|session-usage|bundle|access|openrouter|opr|proxy|models|--models|config|--config|version|update|hybrid|openai|grok|fast|bg|background|sol|sol-fast|terra|luna|5.5|5.4|mini|5.3|spark|5.2) ;;
    --model|-m|--model=*) set -- hybrid "$@" ;;
    *) set -- hybrid "$default_hybrid_model" "$@" ;;
  esac
elif [[ "$default_profile" == 'grok' ]]; then
  case "${1:-}" in
    mode|usage|session-usage|bundle|access|openrouter|opr|proxy|models|--models|config|--config|version|update|hybrid|openai|grok|fast|bg|background|sol|sol-fast|terra|luna|5.5|5.4|mini|5.3|spark|5.2) ;;
    --model|-m|--model=*) set -- grok "$@" ;;
    *) set -- grok "$default_grok_model" "$@" ;;
  esac
fi

if [[ "${1:-}" == 'mode' ]]; then
  shift
  run_access mode "$@"
  exit $?
fi

if [[ "${1:-}" == 'usage' ]]; then
  shift
  run_access usage "$@"
  exit $?
fi

if [[ "${1:-}" == 'session-usage' ]]; then
  shift
  if [[ -z "${AIRLOCK_SESSION_ROUTER_URL:-}" ]]; then
    printf 'airlock session-usage: this command is available only inside an active hybrid Airlock session.\n' >&2
    exit 1
  fi
  run_access session-usage --router-url "$AIRLOCK_SESSION_ROUTER_URL" "$@"
  exit $?
fi

if [[ "${1:-}" == 'fast' && "${2:-}" == '--arm' ]]; then
  shift 2
  if (( $# != 2 )) || [[ "$1" != '--session-id' || -z "$2" ]]; then
    printf 'airlock: usage: airlock fast --arm --session-id SESSION_ID\n' >&2
    exit 2
  fi
  validate_managed_bundle || exit $?
  validate_ephemeral_fast_root || exit $?
  run_access fast-transition-arm --session-id "$2"
  exit $?
fi

if [[ "${1:-}" == 'version' ]]; then
  shift
  if (( $# != 0 )); then
    printf 'airlock: usage: airlock version\n' >&2
    exit 2
  fi
  validate_managed_bundle || exit $?
  run_update version --manifest "$plugin_dir/.claude-plugin/plugin.json"
  exit $?
fi

if [[ "${1:-}" == 'update' ]]; then
  shift
  if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != '--check' && "$1" != '--yes' && "$1" != '--help' && "$1" != '-h' ]]; }; then
    printf 'airlock: usage: airlock update [--check|--yes|--help]\n' >&2
    exit 2
  fi
  validate_managed_bundle || exit $?
  run_update update --manifest "$plugin_dir/.claude-plugin/plugin.json" --notice-file "$update_notice_file" "$@"
  exit $?
fi

if [[ "${1:-}" == 'bundle' ]]; then
  shift
  if (( $# != 0 )); then
    printf 'airlock: usage: airlock bundle\n' >&2
    exit 2
  fi
  validate_managed_bundle || exit $?
  printf 'Managed bundle is current and complete.\n'
  exit 0
fi

if [[ "${1:-}" == 'hybrid' ]]; then
  shift
  choose_root=0
  if [[ "${1:-}" == 'choose' ]]; then
    choose_root=1
    shift
  fi
  root_alias=''
  hybrid_selected_route=''
  HYBRID_SELECTED_ROUTE=''
  hybrid_candidate="$(normalize_openai_model_id "${1:-}")"
  if [[ "$hybrid_candidate" == 'auto' ]]; then
    # Reserved value: resolve under the local access policy, never an alias.
    root_alias='auto'
    shift
  elif resolve_hybrid_alias "$hybrid_candidate" 2>/dev/null; then
    root_alias="$hybrid_candidate"
    shift
  elif [[ -n "$hybrid_candidate" && "$hybrid_candidate" != -* ]] && \
       [[ "$hybrid_candidate" =~ ^[a-z0-9]+([._:-][a-z0-9]+)*$ ]]; then
    # A route-shaped first word tries the OpenRouter registry before anything
    # else. Anything that cannot be a route slug (flags, prose) stays untouched.
    OPR_SELECTED_ROUTE=''
    OPR_ROOT_MODEL=''
    OPR_ROOT_NAME=''
    if resolve_openrouter_root "$hybrid_candidate"; then
      hybrid_selected_route="$OPR_SELECTED_ROUTE"
      shift
    else
      printf "airlock: '%s' is neither a hybrid root alias nor an enabled OpenRouter route.\n" \
        "$hybrid_candidate" >&2
      exit 2
    fi
  fi

  explicit_model=''
  hybrid_args=("$@")
  for ((index=0; index<${#hybrid_args[@]}; index++)); do
    argument="${hybrid_args[$index]}"
    if [[ "$argument" == '--model' ]]; then
      if (( index + 1 >= ${#hybrid_args[@]} )); then
        printf 'airlock: --model requires a value.\n' >&2
        exit 2
      fi
      explicit_model="$(normalize_openai_model_id "${hybrid_args[$((index + 1))]}")"
      hybrid_args[$((index + 1))]="$explicit_model"
      break
    elif [[ "$argument" == --model=* ]]; then
      explicit_model="$(normalize_openai_model_id "${argument#--model=}")"
      hybrid_args[$index]="--model=$explicit_model"
      break
    fi
  done

  if [[ -z "$hybrid_selected_route" && -z "$root_alias" && -z "$explicit_model" ]]; then
    if [[ "$choose_root" -eq 1 ]]; then
      select_hybrid_root
      if [[ -n "$HYBRID_SELECTED_ROUTE" ]]; then
        hybrid_selected_route="$HYBRID_SELECTED_ROUTE"
        root_model="$OPR_ROOT_MODEL"
        root_name="$OPR_ROOT_NAME"
        root_provider='openrouter'
      fi
    else
      root_alias="$default_hybrid_model"
      if [[ "$root_alias" == 'auto' && -n "$resolved_auto_alias" ]]; then
        root_alias="$resolved_auto_alias"
      fi
    fi
  fi
  if [[ "$root_alias" == 'auto' ]]; then
    [[ -n "$resolved_auto_alias" ]] || resolve_auto_hybrid_root || exit $?
    root_alias="$resolved_auto_alias"
  fi
  if [[ -z "$hybrid_selected_route" ]]; then
    if [[ -z "$root_alias" && -z "$explicit_model" ]]; then
      # Unreachable in practice; guards the resolution below.
      root_alias="$default_hybrid_model"
      if [[ "$root_alias" == 'auto' && -n "$resolved_auto_alias" ]]; then
        root_alias="$resolved_auto_alias"
      fi
    fi
    if [[ -n "$root_alias" ]]; then
      resolve_hybrid_alias "$root_alias" || {
        printf "airlock: unsupported saved hybrid model '%s'\n" "$root_alias" >&2
        exit 2
      }
    else
      root_model="$explicit_model"
      root_name="$explicit_model"
      root_provider="$(model_provider "$explicit_model" || true)"
      if [[ -z "$root_provider" ]]; then
        printf 'airlock: cannot determine the hybrid root provider from --model; use a gpt-*, claude-*, or grok-* model ID.\n' >&2
        exit 2
      fi
    fi

    if [[ -n "$explicit_model" && -n "$root_alias" ]]; then
      explicit_provider="$(model_provider "$explicit_model" || true)"
      if [[ -z "$explicit_provider" || "$explicit_provider" != "$root_provider" ]]; then
        printf 'airlock: hybrid root alias and --model must select the same provider.\n' >&2
        exit 2
      fi
      root_model="$explicit_model"
      root_name="$explicit_model"
    elif [[ -z "$explicit_model" ]]; then
      hybrid_args=(--model "$root_model" ${hybrid_args[@]+"${hybrid_args[@]}"})
    fi
  else
    # An OpenRouter route is selected by exact registry slug. A forwarded
    # --model may only restate the resolved root model; anything else would
    # move root traffic off the selected route inside one argv.
    root_model="$OPR_ROOT_MODEL"
    root_name="$OPR_ROOT_NAME"
    root_provider='openrouter'
    if [[ -n "$explicit_model" && "$explicit_model" != "$root_model" ]]; then
      printf 'airlock: forwarded --model disagrees with the selected OpenRouter root route (%s).\n' "$root_model" >&2
      exit 2
    fi
    if [[ -z "$explicit_model" ]]; then
      hybrid_args=(--model "$root_model" ${hybrid_args[@]+"${hybrid_args[@]}"})
    fi
  fi

  has_effort=0
  for argument in ${hybrid_args[@]+"${hybrid_args[@]}"}; do
    [[ "$argument" == '--effort' || "$argument" == --effort=* ]] && has_effort=1
  done
  if [[ "$has_effort" -eq 0 ]]; then
    root_effort="${AIRLOCK_MAIN_EFFORT:-${config_main_effort:-high}}"
    validate_effort "$root_effort"
    hybrid_args=(--effort "$root_effort" ${hybrid_args[@]+"${hybrid_args[@]}"})
  fi

  unset AIRLOCK_HYBRID AIRLOCK_GPT_HYBRID AIRLOCK_GROK_HYBRID AIRLOCK_OPENROUTER_HYBRID
  if [[ "$root_provider" == 'openrouter' ]]; then
    export AIRLOCK_OPENROUTER_HYBRID='1'
    launch_session hybrid-openrouter-root "$root_model" "$root_name" \
      "$hybrid_selected_route" ${hybrid_args[@]+"${hybrid_args[@]}"}
  elif [[ "$root_provider" == 'openai' ]]; then
    validate_fast_root_model "$root_model"
    export AIRLOCK_GPT_HYBRID='1'
    launch_session hybrid-openai-root "$root_model" "$root_name" '' ${hybrid_args[@]+"${hybrid_args[@]}"}
  elif [[ "$root_provider" == 'grok' ]]; then
    # A Grok root cannot start without an enabled Grok route, so an explicit
    # Grok root turns the routes on. Every other hybrid root leaves Grok off
    # unless the saved config enables it, because advertising a worker whose
    # provider the user never logged into would fail at request time.
    if [[ -z "${AIRLOCK_GROK_MODELS+x}" ]]; then
      export AIRLOCK_GROK_MODELS='grok,composer'
    fi
    export AIRLOCK_GROK_HYBRID='1'
    launch_session hybrid-grok-root "$root_model" "$root_name" '' ${hybrid_args[@]+"${hybrid_args[@]}"}
  else
    export AIRLOCK_HYBRID='1'
    launch_session hybrid-anthropic-root "$root_model" "$root_name" '' ${hybrid_args[@]+"${hybrid_args[@]}"}
  fi
  exit $?
fi

if [[ "${1:-}" == 'opr' ]]; then
  shift
  if (( $# > 0 )) && [[ "$1" == '--help' || "$1" == '-h' ]]; then
    printf '%s\n' \
      'Usage: airlock opr [ROUTE] [Claude arguments...]' \
      '' \
      'Start an OpenRouter-only session on one exact enabled registry route.' \
      'Omit ROUTE in an interactive terminal to choose from the offline registry.' \
      'Use airlock openrouter auth and airlock openrouter models to manage access.'
    exit 0
  fi
  OPR_SELECTED_ROUTE=''
  OPR_ROOT_MODEL=''
  OPR_ROOT_NAME=''
  if (( $# > 0 )) && [[ "$1" != -* ]]; then
    OPR_SELECTED_ROUTE="$1"
    shift
  else
    select_openrouter_root || exit $?
  fi
  resolve_openrouter_root "$OPR_SELECTED_ROUTE" || exit $?
  opr_args=("$@")
  for argument in ${opr_args[@]+"${opr_args[@]}"}; do
    case "$argument" in
      --model|-m|--model=*)
        printf 'airlock: OpenRouter roots are selected by exact registry route; --model and -m cannot be forwarded.\n' >&2
        exit 2
        ;;
    esac
  done
  opr_args=(--model "$OPR_ROOT_MODEL" ${opr_args[@]+"${opr_args[@]}"})
  unset AIRLOCK_HYBRID AIRLOCK_GPT_HYBRID AIRLOCK_GROK_HYBRID AIRLOCK_OPENROUTER_HYBRID
  launch_session openrouter-pure "$OPR_ROOT_MODEL" "$OPR_ROOT_NAME" \
    "$OPR_SELECTED_ROUTE" ${opr_args[@]+"${opr_args[@]}"}
  exit $?
fi

if [[ "${1:-}" == 'openrouter' ]]; then
  shift
  openrouter_command="${1:-}"
  if (( $# > 0 )); then shift; fi
  case "$openrouter_command" in
    auth)
      openrouter_auth_action="${1:-status}"
      if (( $# > 0 )); then shift; fi
      case "$openrouter_auth_action" in
        set-key)
          if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != '--stdin' ]]; }; then
            printf 'airlock: usage: airlock openrouter auth set-key [--stdin]\n' >&2
            exit 2
          fi
          ;;
        status)
          if (( $# != 0 )); then
            printf 'airlock: usage: airlock openrouter auth status\n' >&2
            exit 2
          fi
          ;;
        logout)
          if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != '--yes' ]]; }; then
            printf 'airlock: usage: airlock openrouter auth logout [--yes]\n' >&2
            exit 2
          fi
          ;;
        *)
          printf 'airlock: unsupported OpenRouter auth action: %s\n' \
            "$openrouter_auth_action" >&2
          exit 2
          ;;
      esac
      run_openrouter_auth "$openrouter_auth_action" "$@"
      exit $?
      ;;
    models)
      run_openrouter_models "$@"
      exit $?
      ;;
    *)
      printf 'airlock: usage: airlock openrouter auth|models ...\n' >&2
      exit 2
      ;;
  esac
fi

if [[ "${1:-}" == 'proxy' ]]; then
  shift
  proxy_provider='codex'
  if [[ "${1:-}" == 'grok' ]]; then
    proxy_provider='grok'
    shift
  fi
  if [[ "${1:-}" != 'auth' ]]; then
    printf 'airlock: usage: airlock proxy [grok] auth [status|login|device]\n' >&2
    exit 2
  fi
  shift
  proxy_auth_action="${1:-status}"
  if (( $# > 0 )); then shift; fi
  if (( $# != 0 )); then
    printf 'airlock: usage: airlock proxy [grok] auth [status|login|device]\n' >&2
    exit 2
  fi
  case "$proxy_auth_action" in
    status|login|device) ;;
    *)
      printf 'airlock: unsupported proxy auth action: %s\n' "$proxy_auth_action" >&2
      exit 2
      ;;
  esac
  if ! command -v claude-code-proxy >/dev/null 2>&1; then
    printf 'airlock: claude-code-proxy is not on PATH.\n' >&2
    exit 1
  fi
  prepare_private_proxy_directory "$proxy_config_dir" || exit $?
  prepare_private_proxy_directory "$proxy_state_home" || exit $?
  run_proxy_command "$proxy_provider" auth "$proxy_auth_action"
  exit $?
fi

if [[ "${1:-}" == 'grok' ]]; then
  shift
  requested_grok="$default_grok_model"
  case "${1:-}" in
    --model|-m)
      [[ $# -ge 2 ]] || { printf 'airlock: %s requires a model\n' "$1" >&2; exit 2; }
      requested_grok="$2"
      shift 2
      ;;
    --model=*)
      requested_grok="${1#--model=}"
      [[ -n "$requested_grok" ]] || { printf 'airlock: --model requires a model\n' >&2; exit 2; }
      shift
      ;;
    *)
      if [[ $# -gt 0 ]] && resolve_grok_model "$1" >/dev/null 2>&1; then
        requested_grok="$1"
        shift
      fi
      ;;
  esac
  resolve_grok_model "$requested_grok" || exit $?
  selected_effort="${AIRLOCK_MAIN_EFFORT:-${config_main_effort:-high}}"
  validate_effort "$selected_effort"
  # Pure Grok needs enabled Grok routes even when the shared default is unavailable.
  if [[ -z "${AIRLOCK_GROK_MODELS+x}" ]]; then
    export AIRLOCK_GROK_MODELS='grok,composer'
  fi
  set_openai_environment "$selected_model" "$model_name" 'Grok subscription'
  unset AIRLOCK_HYBRID AIRLOCK_GPT_HYBRID AIRLOCK_GROK_HYBRID AIRLOCK_OPENROUTER_HYBRID
  has_effort=0
  for argument in "$@"; do
    [[ "$argument" == '--effort' || "$argument" == --effort=* ]] && has_effort=1
  done
  session_args=(--model "$selected_model")
  [[ "$has_effort" -eq 1 ]] || session_args+=(--effort "$selected_effort")
  session_args+=("$@")
  launch_session grok-pure "$selected_model" "$model_name" '' "${session_args[@]}"
  exit $?
fi

requested_model="$default_openai_model"
selected_effort="${AIRLOCK_MAIN_EFFORT:-${config_main_effort:-high}}"
ephemeral_fast=0
case "${1:-}" in
  models|--models) print_models; exit 0 ;;
  config|--config) print_config; exit 0 ;;
  access)
    shift
    case "${1:-show}" in
      show) run_access show ;; refresh) run_access refresh ;;
      *) printf 'airlock: usage: airlock access [show|refresh]\n' >&2; exit 2 ;;
    esac
    exit $?
    ;;
  --model|-m)
    [[ $# -ge 2 ]] || { printf 'airlock: %s requires a model\n' "$1" >&2; exit 2; }
    requested_model="$2"; shift 2
    ;;
  --model=*)
    requested_model="${1#--model=}"
    [[ -n "$requested_model" ]] || { printf 'airlock: --model requires a model\n' >&2; exit 2; }
    shift
    ;;
  openai)
    shift
    case "${1:-}" in
      --model|-m)
        [[ $# -ge 2 ]] || { printf 'airlock: %s requires a model\n' "$1" >&2; exit 2; }
        requested_model="$2"
        shift 2
        ;;
      --model=*)
        requested_model="${1#--model=}"
        [[ -n "$requested_model" ]] || { printf 'airlock: --model requires a model\n' >&2; exit 2; }
        shift
        ;;
      *)
        if [[ $# -gt 0 ]] && resolve_model "$1" >/dev/null 2>&1; then
          requested_model="$1"
          shift
        fi
        ;;
    esac
    ;;
  bg|background)
    requested_model="$default_bg_model"
    selected_effort="${AIRLOCK_BG_EFFORT:-${AIRLOCK_BACKGROUND_EFFORT:-${config_bg_effort:-medium}}}"
    shift
    ;;
  fast)
    shift
    for argument in "$@"; do
      case "$argument" in
        --model|-m|--model=*)
          printf 'airlock: Fast uses the fixed gpt-5.6-sol-fast root; %s cannot be forwarded.\n' "$argument" >&2
          exit 2
          ;;
      esac
    done
    validate_ephemeral_fast_root || exit $?
    ephemeral_fast=1
    requested_model='sol-fast'
    ;;
  sol|sol-fast|terra|luna|5.5|5.4|mini|5.3|spark|5.2) requested_model="$1"; shift ;;
esac
validate_effort "$selected_effort"
resolve_model "$requested_model"
if [[ "$ephemeral_fast" -eq 0 ]]; then
  validate_fast_root_model "$selected_model"
fi
set_openai_environment "$selected_model" "$model_name"
unset AIRLOCK_HYBRID AIRLOCK_GPT_HYBRID AIRLOCK_GROK_HYBRID AIRLOCK_OPENROUTER_HYBRID

has_effort=0
for argument in "$@"; do
  [[ "$argument" == '--effort' || "$argument" == --effort=* ]] && has_effort=1
done
session_args=(--model "$selected_model")
[[ "$has_effort" -eq 1 ]] || session_args+=(--effort "$selected_effort")
session_args+=("$@")
launch_session openai-pure "$selected_model" "$model_name" '' "${session_args[@]}"
