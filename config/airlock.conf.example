# Managed by https://github.com/Harshkamdar67/Airlock
# Plain key=value configuration. Do not put credentials in this file.
# Bare airlock starts the saved hybrid root. Use `airlock openai` for the
# OpenAI-only profile. Older configs without this key keep their old behavior.
AIRLOCK_DEFAULT_PROFILE=hybrid
AIRLOCK_HYBRID_MODEL=sol
# Saved OpenAI-only root, also used by `airlock openai`.
AIRLOCK_MODEL=sol
# Saved Grok-only root, also used by `airlock grok`. Requires Grok OAuth on the
# local subscription proxy (`airlock proxy grok auth login`).
AIRLOCK_GROK_MODEL=grok
# Enabled Grok workers. Empty or absent keeps Grok off, which is the default,
# because Grok signs in separately from Codex. `airlock grok` and
# `airlock hybrid grok` enable grok,composer themselves, since naming a Grok
# root is an explicit request for that provider.
# AIRLOCK_GROK_MODELS=grok,composer
AIRLOCK_GROK_MODELS=
# AIRLOCK_EFFORT_GROK=inherit
# AIRLOCK_EFFORT_COMPOSER=inherit
# OpenRouter is not configured through this file. It stays off by default and
# has no key here on purpose; the key lives only in the operating system's own
# credential storage. Turn it on with `airlock openrouter auth set-key` and
# `airlock openrouter models add`, which write to a separate local registry file.
# Starting effort for the root session. Change it live with /effort.
AIRLOCK_MAIN_EFFORT=high
# Advanced: separate convenience command. Normal Agents do not use this lane.
AIRLOCK_BG_MODEL=sol
AIRLOCK_BG_EFFORT=medium
# Advanced: model for lightweight Claude Code requests such as titles.
AIRLOCK_SMALL_FAST_MODEL=gpt-5.6-luna
# Effort for every airlock-* worker. "inherit" means a worker follows the
# session level, so /effort moves the root and its workers together, including
# mid-session. Any named level pins workers and /effort no longer reaches them.
AIRLOCK_WORKER_EFFORT=inherit
# Pin one worker without pinning the rest. AIRLOCK_EFFORT_<ROUTE> wins over
# AIRLOCK_WORKER_EFFORT, and accepts inherit to hand that worker back to /effort.
# AIRLOCK_EFFORT_LUNA=max
# AIRLOCK_EFFORT_OPUS=xhigh
# Advanced: optional generic airlock-worker, separate from exact named workers.
AIRLOCK_SUBAGENT_EFFORT=inherit
AIRLOCK_EXTRA_USAGE_POLICY=ask
AIRLOCK_ROUTING_POLICY=balanced
AIRLOCK_MAX_CONCURRENT_SUBAGENTS=off
# Provider Fast startup is off by default. OpenAI Fast applies only to eligible
# Fast routes. Anthropic Fast applies only to supported Opus roots and uses paid
# usage credits from the first token. These settings affect Airlock sessions only.
AIRLOCK_OPENAI_FAST=off
AIRLOCK_ANTHROPIC_FAST=off
# Advanced selection within an enabled OpenAI Fast policy.
AIRLOCK_SWARM_FAST=auto
AIRLOCK_FAILOVER_POLICY=ask
# Anthropic 429s default to Claude Code's native reset-time and resume handling.
# Use handoff for cross-provider continuity, including automatic compaction when
# the Claude plan is exhausted. `airlock mode anthropic-rate-limit ...` saves it.
AIRLOCK_ANTHROPIC_RATE_LIMIT=native
# What the router does when an overflowing handoff fits no peer's context
# window: auto condenses history through the destination provider's economy
# worker when enabled and falls back to trimming, truncate only trims locally,
# summarize refuses to trim, and off keeps the honest failure. Compaction
# spends tokens on a model already enabled in your session.
AIRLOCK_OVERFLOW_SHRINK=auto
AIRLOCK_ANTHROPIC_PLAN=unknown
AIRLOCK_OPENAI_CAPACITY=auto
AIRLOCK_ANTHROPIC_MODELS=opus,sonnet,haiku
AIRLOCK_OPENAI_MODELS=sol,terra,luna
AIRLOCK_ANTHROPIC_EXTRA_MODELS=fable
AIRLOCK_OPENAI_EXTRA_MODELS=
# Auto-compact window for roots Claude Code cannot recognize, which means the
# OpenAI and Grok models reaching it through the proxy. Anthropic roots are left
# alone so Claude Code keeps its own tuned window and the /config control stays
# usable. Accepts auto, which never sets the window, or 100000 to 1000000.
AIRLOCK_CONTEXT_WINDOW=272000
# Effort levels Claude Code should offer when the root is a GPT model. Claude
# Code recognizes Anthropic model IDs on its own, so this only applies to GPT
# roots. Anything left off this list is turned off for them.
AIRLOCK_GPT_EFFORT_CAPABILITIES=effort,xhigh_effort,max_effort
AIRLOCK_PROXY_URL=http://127.0.0.1:18765
# Usually blank. Setup fills these only when the proxy's normal user-owned
# config or state parent is not writable. They are directory paths, not tokens.
AIRLOCK_PROXY_CONFIG_DIR=
AIRLOCK_PROXY_STATE_HOME=
